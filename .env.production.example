# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Token from Cloudflare Zero Trust → Networks → Tunnels → your tunnel
TUNNEL_TOKEN=your_cloudflare_tunnel_token

# ── Frontend build args (forwarded to Docker build) ───────────────────────────
# These PUBLIC_ vars are inlined into client JS at build time.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...your_anon_key
PUBLIC_API_URL=https://api.kundaro.de
PUBLIC_SITE_URL=https://kundaro.de
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx
TURNSTILE_SITE_KEY=0x4AAAAAAA...

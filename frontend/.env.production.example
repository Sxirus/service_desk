# ── General ────────────────────────────────────────────────────────────────────
DEBUG=false
ENABLE_PERFORMANCE_TRACKING=false

# ── URLs ──────────────────────────────────────────────────────────────────────
# SSR-side API URL (internal Docker network, never exposed to browser)
API_URL=http://backend:3000
INTERNAL_API_URL=http://backend:3000

# Public-facing site URL (used for redirects, OAuth callbacks)
ASTRO_URL=https://kundaro.de
PUBLIC_SITE_URL=https://kundaro.de

# Public API URL (sent to browser for client-side API calls)
PUBLIC_API_URL=https://api.kundaro.de

# ── Supabase ──────────────────────────────────────────────────────────────────
# Server-side (service role key — secret, never exposed to browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# Client-side (anon key — safe for browser)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...your_anon_key

# ── Stripe ────────────────────────────────────────────────────────────────────
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx

# ── Cloudflare Turnstile ──────────────────────────────────────────────────────
TURNSTILE_SITE_KEY=0x4AAAAAAA...

# ── Shopify ───────────────────────────────────────────────────────────────────
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_SECRET=your_shopify_secret
SHOPIFY_REDIRECT_URI=https://api.kundaro.de/api/shopify/callback

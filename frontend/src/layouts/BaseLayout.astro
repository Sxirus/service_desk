---
// src/layouts/BaseLayout.astro

/**
 * Base Layout Component
 * Provides the HTML structure for all pages in the application
 * 
 * Props:
 * @param {string} title - Page title for <title> tag (default: "App")
 * @param {boolean} overflowHidden - Whether to hide body overflow (default: false)
 */

interface Props {
  title?: string;
  overflowHidden?: boolean;
}

const { 
  title = "App", 
  overflowHidden = false 
} = Astro.props;

// Get language from cookie for SSR consistency
const supportedLangs = ['en', 'de', 'zh'];
const langCookie = Astro.cookies.get('i18nextLng')?.value;
const initialLanguage = (langCookie && supportedLangs.includes(langCookie)) ? langCookie : 'en';

import { Toaster } from "sonner";
import { MobileWarning } from "../components/mobile-warning";
import { I18nProvider } from "../i18n/I18nProvider";
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang={initialLanguage}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <!-- Cloudflare Turnstile for CAPTCHA -->
    <script
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    ></script>
  </head>
  
  <body class:list={[
    "min-h-screen", 
    overflowHidden && "overflow-hidden"
  ]}>
    <!-- Page content wrapped in I18nProvider -->
    <I18nProvider client:load initialLanguage={initialLanguage}>
      <slot />
      <!-- Mobile Usage Warning -->
      <MobileWarning client:load />
    </I18nProvider>
    <!-- Toast notifications -->
    <Toaster client:load />
  </body>
</html>
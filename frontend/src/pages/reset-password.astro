---
import Layout from "../layouts/BaseLayout.astro";
import { createClient } from "../lib/supabase.ts";
import "../styles/global.css";

// Create Supabase client with server-side rendering support
const supabase = createClient({
    request: Astro.request,
    cookies: Astro.cookies,
});

// Check if user is already authenticated
const { data } = await supabase.auth.getUser();

// Redirect authenticated users to dashboard (they don't need password reset)
if (data.user) {
    return Astro.redirect("/dashboard");
}

// Get Turnstile API key for CAPTCHA
const apiKey = import.meta.env.TURNSTILE_SITE_KEY;

---

<Layout>
    <!-- Password reset form section -->
    <section class="flex flex-col items-center justify-center m-30">
        <h1 style="padding-top: 25px;" class="text-4xl text-left font-bold mb-12">Helpdesk - Passwort vergessen</h1>
        
        <!-- Password reset form with email and CAPTCHA -->
        <form id="signin-form" class="flex flex-col gap-2 w-1/3">
            <label for="email" class="">E-Mail-Adresse:</label>
            <input
                type="email"
                name="email"
                id="email"
                placeholder="youremail@example.com"
                class="border border-gray-500 rounded-md p-2"
                required
            />
            
            <!-- Turnstile CAPTCHA widget -->
            <div class="cf-turnstile" data-sitekey={apiKey}></div>
            
            <!-- Submit button -->
            <button
                type="submit"
                id="sign-in"
                class="bg-gray-600 hover:bg-gray-700 p-2 rounded-md text-white font-bold w-full cursor-pointer disabled:bg-gray-500 disabled:hover:bg-gray-500 disabled:cursor-not-allowed"
                >Passwort zurücksetzen</button
            >
        </form>
    </section>
</Layout>

<script>
    import { actions } from "astro:actions";

    // Extend Window interface to include Turnstile API
    declare global {
        interface Window {
            turnstile?: {
                reset: () => void;
            };
        }
    }

    // Get form and submit button references
    const signInForm = document.querySelector("#signin-form") as HTMLFormElement;
    const formSubmitBtn = document.getElementById("sign-in") as HTMLButtonElement;

    // Handle form submission for password reset
    signInForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        
        // Disable button and show loading state
        formSubmitBtn.disabled = true;
        formSubmitBtn.textContent = "Passwort zurücksetzen...";

        try {
            // Get Turnstile CAPTCHA token
            const turnstileToken = (
                document.querySelector(
                    "[name='cf-turnstile-response']"
                ) as HTMLInputElement
            )?.value;

            // Check if CAPTCHA was completed
            if (!turnstileToken) {
                throw new Error("verification_missing");
            }

            // Prepare form data with CAPTCHA token
            const formData = new FormData(signInForm);
            formData.append("captchaToken", turnstileToken);

            // Submit password reset request
            const results = await actions.resetPassword(formData);

            // Handle password reset failure
            if (!results.data?.success) {
                // Handle CAPTCHA verification failure
                if (results.data?.message?.includes("captcha protection")) {
                    alert("Verifizierung fehlgeschlagen. Bitte versuche es erneut.");
                    // Reset CAPTCHA widget
                    if (window.turnstile) {
                        window.turnstile.reset();
                    }
                    formSubmitBtn.disabled = false;
                    formSubmitBtn.textContent = "Passwort zurücksetzen";
                    return;
                } else {
                    // Handle other reset errors
                    alert("Ups! Passwort zurücksetzen fehlgeschlagen. Bitte versuche es erneut.");
                    formSubmitBtn.disabled = false;
                    formSubmitBtn.textContent = "Passwort zurücksetzen";
                    return;
                }
            }

            // Password reset successful - show success message
            formSubmitBtn.textContent = "Passwort zurücksetzen";
            alert("Bitte überprüfe deine E-Mail-Postfach, um dein Passwort zurückzusetzen");
        } catch (error) {
            // Handle unexpected errors
            if (window.turnstile) {
                window.turnstile.reset();
            }
            formSubmitBtn.disabled = false;
            formSubmitBtn.textContent = "Passwort zurücksetzen";
            console.log(error);
            alert("Etwas ist schief gelaufen. Bitte versuche es erneut");
        }
    });
</script>
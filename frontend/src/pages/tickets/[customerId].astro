---
import BaseLayout from "../../layouts/BaseLayout.astro";
//parameters
const { params } = Astro;
const customerId = params.customerId;
//getting the customer
const resultCustomer = await fetch(`http://localhost:3000/api/customers/getCustomerById?customerId=${customerId}`);
const customerArray = await resultCustomer.json();
const customer = customerArray[0];
//getting all the emails from a customer
const resultMails = await fetch(`http://localhost:3000/api/emails/getEmailsFromCustomer?customerId=${customerId}`);
const emailArray = await resultMails.json();
const lastMail = emailArray[emailArray.length - 1]
const emailAdress = lastMail.email_address;
const newSubject = `RE: ${lastMail.subject}`

---

<BaseLayout title={customer.name}>
  <!-- the right side -->
  <div class="fixed right-0 bg-gray-100 h-full w-1/5 outline outline-2 outline-gray-300 flex justify-center">
    <p> Name: {customer.name}</p>
    <button id="sendButton" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 absolute bottom-7 w-4/5">Send</button>
  </div>
  
  <!-- all the mails of the customer -->
  <div class="relative w-4/5 h-screen">
    <h1 class="text-6xl w-full m-4">{lastMail.subject}</h1>
    <ul class="w-full">
      {emailArray.map(mail => (
      <li class="outline outline-2 outline-gray-300">
        <p class="">{mail.text_content}</p>
      </li>
    ))};
    </ul>
    <textarea class="w-full h-1/5 absolute bottom-3 resize-none overflow-y-auto p-2 border border-gray-300" placeholder="Answer..." id="answer"></textarea>
  </div>
  <script>
    const emailAdress = "{emailAdress}";
    const newSubject = "{newSubject}";
    const button = document.getElementById('sendButton');
    const textarea = document.getElementById('answer')as HTMLTextAreaElement;

    //send button action
    button?.addEventListener('click', async() => {
      const body = textarea.value;
      //sending mail
      await fetch('http://localhost:3000/api/mail/send', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          to: emailAdress,
          subject: newSubject,
          text: body,
        }),
      });
    });
  </script>
</BaseLayout>

---
/**
 * Customer Ticket Detail View
 * 
 * This page displays:
 * - Email conversation thread with a customer
 * - Customer information in the right sidebar
 * - Shopify order history (if store is connected)
 * - Macro search for quick responses
 * - Reply functionality (RESIZABLE & COLLAPSIBLE)
 * 
 * Security: Authenticated users only
 * Uses: Auth helper for DRY authentication/authorization
 * 
 * Performance: Tracks all major operations when ENABLE_PERFORMANCE_TRACKING=true
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../utils/formatDate.js";
import { MacroSearch } from "../../components/macroSearch.jsx";
import { Assign } from "../../components/zuweisung.jsx";
import { createClient } from "../../lib/supabase.ts";
import { ShopifyOrders } from "../../components/ShopifyOrders";
import { CustomerInfo } from "../../components/CustomerInfo";
import { getCompletePageContext } from "../../lib/auth-helpers.ts";
import { createPageLogger, perf } from "../../utils/logger.ts";
import AdminShell from "@/components/AdminShell";
import type { ShopifyConfig, ShopifyClientData } from "../../types/shopify.types";
import { apiClient } from "../../utils/api.ts";


const log = createPageLogger('customer-ticket');
log.info('Page accessed');

// ============================================================================
// PERFORMANCE TRACKING - START
// ============================================================================
const pageLoadTimer = perf.start('page-load', 'total');

// ============================================================================
// ROUTE PARAMETERS
// ============================================================================

const { params } = Astro;
const customerId = params.customerId;

log.info('Customer ID: ', customerId);

// ============================================================================
// AUTHENTICATION & AUTHORIZATION
// ============================================================================

const authTimer = perf.start('page-load', 'authentication');

// USE PRE-AUTHENTICATED USER FROM MIDDLEWARE
const supabase = Astro.locals.supabase || createClient({ 
  request: Astro.request, 
  cookies: Astro.cookies 
});

const { data: { session } } = await supabase.auth.getSession();
if (!session) {
  log.error('No session found, redirecting to login');
  return Astro.redirect("/");
}

//getting tokens for browser session
const browserTokens = session 
  ? { access: session.access_token, refresh: session.refresh_token }
  : null;

log.info('Verifying authentication');
// PASS PRE-AUTHENTICATED USER - NO DOUBLE AUTH!
const pageContext = await getCompletePageContext(
  supabase, 
  Astro.cookies,
  Astro.locals.user
);

perf.end(authTimer);

if (!pageContext) {
  log.error('Authentication failed, redirecting to login');
  perf.end(pageLoadTimer, { result: 'auth-failed' });
  perf.printReport('customer-ticket');
  return Astro.redirect("/");
}

const { authContext, sidebarData } = pageContext;
log.info('User authenticated', { userId: authContext.user.id, employeeId: authContext.employee.id, clientId: authContext.employee.client_id });

const clientId = authContext.employee.client_id;

// ============================================================================
// DATA LOADING - OPTIMIZED WITH PARALLEL QUERIES
// ============================================================================

const dataFetchTimer = perf.start('page-load', 'data-fetching');
log.info('Starting parallel data fetch');

// Track individual query timings within the parallel execution
const queryTimer = perf.start('database', 'parallel-queries');

const [
  { data: customer, error: customerError },
  { data: incomingMails, error: incomingError },
  { data: sentMails, error: sentError },
  { data: macroArray, error: macroError },
  { data: macroGroups, error: macroGroupsError },
  { data: clientData, error: clientError },
  { data: assignedEmployeeArray, error: assignedEmployeeErr},
  { data: employeeArray, error: employeeErr}
] = await Promise.all([
  supabase
    .from("customers")
    .select(`
      id,
      name,
      client_id,
      employee_id
    `)
    .eq("id", customerId)
    .eq("client_id", clientId)
    .single(),
  
  supabase
    .from("incoming-mails")
    .select(`
      id,
      send_at,
      subject,
      text_content,
      html_content,
      email_address,
      read,
      processing_status
    `)
    .eq("customer_id", customerId)
    .eq("client_id", clientId)
    .order("send_at", { ascending: true }),
  
  supabase
    .from("sent-mail")
    .select(`
      id,
      send_at,
      text_content,
      employee_id
    `)
    .eq("customer_id", customerId)
    .order("send_at", { ascending: true }),
  
  supabase
    .from("macros")
    .select("*")
    .eq("client_id", clientId)
    .order("title", { ascending: true }),
  
  supabase
    .from("macro_groups")
    .select("*")
    .eq("client_id", clientId),

  supabase
    .from("clients")
    .select(`
      id,
      name,
      email_signature,
      shopify_store_url,
      shopify_access_token,
      shopify_connected,
      shopify_scope
    `)
    .eq("id", clientId)
    .single(),

  supabase
    .from("customers")
    .select("employee_id")
    .eq("id", customerId),
  
  supabase
    .from("employees")
    .select("id, name")
    .eq("client_id", clientId)
    .order("name")
]);

perf.end(queryTimer, {
  queries: 5,
  customerFound: !!customer,
  incomingMailsCount: incomingMails?.length || 0,
  sentMailsCount: sentMails?.length || 0,
  macrosCount: macroArray?.length || 0
});

perf.end(dataFetchTimer);

// ============================================================================
// ERROR HANDLING
// ============================================================================

//Log any errors
if (employeeErr) {
  console.error("[customer-ticket] Failed to load assigned employee", {
    error: employeeErr.message,
    code: employeeErr.code
  })
} else {
  console.log("[customer-ticket] Data Loaded")
}

const errorCheckTimer = perf.start('page-load', 'error-handling');

if (customerError) {
  log.error('Error fetching customer:', customerError);
  perf.end(errorCheckTimer, { result: 'customer-error' });
  perf.end(pageLoadTimer, { result: 'customer-not-found' });
  perf.printReport('customer-ticket');
  return new Response("Customer not found", { status: 404 });
}

if (!customer) {
  log.error('Customer not found or access denied');
  perf.end(errorCheckTimer, { result: 'customer-not-found' });
  perf.end(pageLoadTimer, { result: 'customer-not-found' });
  perf.printReport('customer-ticket');
  return new Response("Customer not found", { status: 404 });
}

log.info('Customer loaded:', customer.name);

if (clientError) {
  log.error('Error fetching client data:', clientError);
  perf.end(errorCheckTimer, { result: 'client-error' });
  perf.end(pageLoadTimer, { result: 'server-error' });
  perf.printReport('customer-ticket');
  return new Response("Internal server error", { status: 500 });
}

if (incomingError) {
  log.error('Error fetching incoming mails:', incomingError);
}

if (sentError) {
  log.error('Error fetching sent mails:', sentError);
}

if (macroError) {
  log.error('Error fetching macros:', macroError);
}

if (macroGroupsError) {
  log.error("Error fetching macro groups", macroGroupsError);
}

if (assignedEmployeeErr) {
  log.error('Error fetching the assigned employee', assignedEmployeeErr)
}

perf.end(errorCheckTimer);

// ============================================================================
// DATA PROCESSING
// ============================================================================

const processingTimer = perf.start('page-load', 'data-processing');

const incomingIds = (incomingMails || []).map((m:any) => m.id);
interface Attachment {
  id: string;
  email_id: string;
  filename: string;
  mime_type: string;
  object_path: string;
  byte_size: number;
  created_at: string;
}

let attsByEmailId: Record<string, Attachment[]> = {};
if (incomingIds.length) {
  const { data: attRows, error: attErr } = await supabase
    .from('email-attachments')
    .select('id,email_id,filename,mime_type,object_path,byte_size,created_at')
    .in('email_id', incomingIds);

  if (attErr) {
    console.error('[attachments] load error:', attErr);
  } else {
    for (const r of (attRows || [])) {
      if (!attsByEmailId[r.email_id]) {
        attsByEmailId[r.email_id] = [];
      }
      attsByEmailId[r.email_id].push(r);
    }
  }
}

const emailArray = [
  ...(incomingMails || []).map((mail: any) => ({
    ...mail,
    type: 'incoming',
    email_adress: mail.email_address
  })),
  ...(sentMails || []).map((mail: any) => ({
    ...mail,
    type: 'sent',
    employee_id: mail.employee_id
  }))
].sort((a, b) => new Date(a.send_at).getTime() - new Date(b.send_at).getTime());

log.info("Emails loaded:", emailArray.length);

const emailArrayWithAttachments = emailArray.map(mail => {
  if (mail.type === 'incoming') {
    const attachments = attsByEmailId[mail.id] || [];
    return { ...mail, attachments, has_attachments: attachments.length > 0 };
  }
  return mail;
});

let lastMail = incomingMails && incomingMails.length > 0 
  ? incomingMails[incomingMails.length - 1] 
  : null;

if (!lastMail) {
  log.error("No incoming emails found in thread");
  perf.end(processingTimer, { result: 'no-emails' });
  perf.end(pageLoadTimer, { result: 'no-emails' });
  perf.printReport('customer-ticket');
  return new Response("No emails found", { status: 404 });
}

const emailAddress = lastMail.email_address;
const newSubject = `RE: ${lastMail.subject}`;

const signature = clientData?.email_signature || "";

log.info("Client data loaded:", {
  name: clientData?.name,
  shopifyConnected: clientData?.shopify_connected,
  hasSignature: !!signature
});

log.info("Macros loaded:", macroArray?.length || 0);

const shopifyConfig: ShopifyConfig = {
  connected: clientData?.shopify_connected || false,
  customerId: customerId as string
};

//getting the employee that is assigned
var assignedEmployeeName = null;
if (assignedEmployeeArray[0].employee_id != null) {
  let assignedEmployeeId = assignedEmployeeArray[0].employee_id
  assignedEmployeeName = employeeArray.find((item : any) => item.id === assignedEmployeeId).name
}

//transforming the employeeArray to fit in the type search
const transEmployeeArray = employeeArray.map((employee : any) => ({
  title: employee.name,
  text: employee.id
}))

//context for macro interpreter
var ctx = {
  customerID: customerId,
  employeeName: assignedEmployeeName,
  customerFullName: customer.name,
  customerFirstName: customer.name.split(" ")[0],
  customerLastName: customer.name.split(" ")[1],
  //TODO get the right order number
  shopifyLastOrderNumber: null,
  customerEmail: emailAddress
}

perf.end(processingTimer, {
  emailCount: emailArray.length,
  hasShopify: shopifyConfig.connected
});

// ============================================================================
// PERFORMANCE TRACKING - END
// ============================================================================

perf.end(pageLoadTimer, { result: 'success' });

// Print comprehensive performance report
perf.printReport('customer-ticket');

log.info("[customer-ticket] Page setup complete, rendering");
---

<BaseLayout title={customer?.name || "Customer Ticket"}>
  <AdminShell 
    client:load
    user={sidebarData.user}
    firstTeam={sidebarData.team ?? undefined}
    crumbParentLabel="Dashboard"
    crumbParentHref="/dashboard"
    crumbCurrent={customer?.name || "Ticket"}
    isAdmin={authContext.isAdmin}
    currentPath={`/tickets/${customerId}`}
  >
    <div class="flex gap-6 h-[calc(100vh-5rem)] -mx-6 -mb-6 overflow-hidden">
      <!-- Main Content Area - Email Thread -->
      <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <!-- Page Header -->
        <div class="px-6 mt-2 pt-0 py-2">
          <h1 class="text-2xl font-bold tracking-tight">Conversation with {customer?.name}</h1>
        </div>

        <!-- Email Thread -->
        <div id="emailThread" class="flex-1 px-6 overflow-y-auto overflow-x-hidden">
          <div id="mailList" class="space-y-4 pb-4">
            {emailArrayWithAttachments.map((mail) => {
              const isOutgoing = mail.type === 'sent';
              
              return (
                <div class={`rounded-lg border ${
                  isOutgoing 
                    ? 'bg-blue-50 border-blue-200' 
                    : 'bg-card border-border'
                } shadow-sm`}>
                  <div class="p-4">
                    <!-- Message Header -->
                    <div class="flex items-start justify-between mb-3">
                      <div class="flex items-center gap-2">
                        <div class={`flex h-8 w-8 items-center justify-center rounded-full ${
                          isOutgoing ? 'bg-blue-600' : 'bg-muted'
                        }`}>
                          <svg
                            class={`h-4 w-4 ${isOutgoing ? 'text-white' : 'text-muted-foreground'}`}
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"
                            />
                          </svg>
                        </div>
                        <div>
                          <p class={`text-sm font-semibold ${
                            isOutgoing ? 'text-blue-900' : 'text-foreground'
                          }`}>
                            {isOutgoing ? 'You' : customer?.name || 'Customer'}
                          </p>
                          <p class="text-xs text-muted-foreground">
                            {isOutgoing ? 'Support Agent' : 'Customer'}
                          </p>
                        </div>
                      </div>
                      <time class="text-xs text-muted-foreground">
                        {formatDate(mail.send_at)}
                      </time>
                    </div>

                    <!-- Message Body -->
                    <div class="text-sm text-foreground whitespace-pre-wrap leading-relaxed" style="word-break: break-word; overflow-wrap: anywhere;">
                      {mail.text_content}
                    </div>
                    <div id="sb-token-holder"
                    data-access={browserTokens?.access || ''}
                    data-refresh={browserTokens?.refresh || ''}
                    hidden></div>
                    {mail.has_attachments && (
                      <div class="mt-3">
                        <div class="flex flex-wrap gap-2" id={"atts-" + mail.id}>
                          {mail.attachments.map((att: any) => (
                            <button
                              class="inline-flex items-center gap-2 rounded-md bg-accent px-2.5 py-1 text-xs hover:bg-accent/80"
                              title={"Öffnen: " + att.filename}
                              data-mail={mail.id}
                              data-att={att.id}
                              data-path={att.object_path}
                              data-mime={att.mime_type}
                              onclick="handleShowAttachment(this)"
                            >
                              📎 {att.filename}
                            </button>
                          ))}
                        </div>
                        {/* Preview-Container für angezeigte Bilder/Previews */}
                        <div id={"preview-" + mail.id} class="mt-2 flex flex-wrap gap-2"></div>
                      </div>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        <!-- Reply Area (Resizable & Collapsible) -->
        <div id="replyContainer" class="border-t bg-card flex flex-col" style="min-height: 52px; height: 180px;">
          <!-- Resize Handle -->
          <div
            id="resizeHandle"
            class="h-1.5 bg-border hover:bg-primary cursor-ns-resize transition-colors relative group flex-shrink-0"
            title="Drag to resize"
          >
            <div class="absolute inset-x-0 -top-2 -bottom-2"></div>
          </div>
          
          <!-- Header with Collapse Button -->
          <div class="flex items-center justify-between px-6 pt-3 pb-2 flex-shrink-0">
            <label for="answer" class="text-sm font-medium leading-none">
              Your Reply
            </label>
            <button
              id="collapseButton"
              type="button"
              class="inline-flex items-center justify-center h-8 w-8 rounded-md hover:bg-accent transition-colors"
              title="Collapse reply area"
            >
              <svg
                id="collapseIcon"
                class="h-4 w-4 transition-transform duration-200"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 8.25l-7.5 7.5-7.5-7.5"
                />
              </svg>
            </button>
          </div>

          <!-- Reply Content -->
          <div id="replyContent" class="px-6 pb-4 flex-1 flex flex-col min-h-0">
            <div class="flex gap-3 items-end h-full">
              <textarea
                id="answer"
                class="flex-1 h-full min-h-0 rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 resize-none"
                placeholder="Type your reply..."
              ></textarea>
              <button
                data-email={emailAddress}
                data-subject={newSubject}
                data-customerid={customerId}
                data-signature={signature}
                id="sendButton"
                type="button"
                class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2 flex-shrink-0"
              >
                <svg
                  class="mr-2 h-4 w-4"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5"
                  />
                </svg>
                Send Reply
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Sidebar -->
      <div class="w-80 flex-shrink-0 border-l bg-muted/30 flex flex-col overflow-hidden">
        <div class="flex-1 overflow-y-auto p-6 space-y-6">
          
          <!-- Customer Information Component -->
          <CustomerInfo 
            client:load
            customer={customer}
            emailAddress={emailAddress}
            shopifyConfig={shopifyConfig}
            clientData={clientData || {}}
          />

          <!-- Shopify Orders Component -->
          <ShopifyOrders 
            client:load
            shopifyConfig={shopifyConfig}
            clientData={clientData || {}}
          />

          <!-- Quick Responses Card -->
          <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
            <div class="p-4 space-y-3">
              <h3 class="font-semibold leading-none tracking-tight">
                Quick Responses
              </h3>
              <MacroSearch
                client:load
                items={macroArray}
                groups={macroGroups}
                placeholder="Search macros..."
                eventName='MacroChoosen' 
                customerID={customerId} 
                ctx={ctx}            
                />
            </div>
          </div>

          <!-- Ticket zuweisen -->
          <div id="Zuweisen" data-customerid={customerId} class="rounded-lg border bg-card text-card-foreground shadow-sm">
            <div class="p-4 space-y-3">
              <h3 class="font-semibold leading-none tracking-tight">
                Assign Employee
              </h3>
              <Assign
                client:load
                items={transEmployeeArray}
                placeholder="Search employee..."
                eventName='Zuweisung'
                customerId={customerId}
                assigned={assignedEmployeeName}
              />
            </div>
          </div>     
        </div>
      </div>
    </div>
  </AdminShell>

  <!-- Token für den Browser bereitstellen -->

  <script>
    // ============================================================================
    // GET DOM ELEMENTS
    // ============================================================================

    import  { apiClient } from '../../utils/api.ts';
    import { createClient } from '@supabase/supabase-js';

    console.log("[customer-ticket-client] Script initialized");
    const textarea = document.getElementById('answer') as HTMLTextAreaElement;
    const button = document.getElementById('sendButton') as HTMLButtonElement;
    const replyContainer = document.getElementById('replyContainer') as HTMLElement;
    const resizeHandle = document.getElementById('resizeHandle') as HTMLElement;
    const collapseButton = document.getElementById('collapseButton') as HTMLElement;
    const collapseIcon = document.getElementById('collapseIcon') as HTMLElement;
    const replyContent = document.getElementById('replyContent') as HTMLElement;

    console.log("[customer-ticket-client] DOM elements found:", {
      textarea: !!textarea,
      button: !!button,
      replyContainer: !!replyContainer,
      resizeHandle: !!resizeHandle,
      collapseButton: !!collapseButton
    });

    // Supabase-Browserclient (ENV mit PUBLIC_-Prefix)
    const supabaseBrowser = createClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
      { auth: { persistSession: true, autoRefreshToken: true } }
    );

    const el = document.getElementById('sb-token-holder') as HTMLElement | null;
    const access = el?.dataset.access || '';
    const refresh = el?.dataset.refresh || '';
    if (access && refresh) {
      await supabaseBrowser.auth.setSession({ access_token: access, refresh_token: refresh });
    }

    // ============================================================================
    // COLLAPSE/EXPAND FUNCTIONALITY
    // ============================================================================

    let isCollapsed = false;
    const COLLAPSED_HEIGHT = '52px';
    
    // Load saved collapsed state
    const savedCollapsedState = localStorage.getItem('replyAreaCollapsed');
    
    if (savedCollapsedState === 'true') {
      isCollapsed = true;
      if (replyContainer && replyContent && collapseIcon) {
        replyContainer.style.height = COLLAPSED_HEIGHT;
        replyContent.style.display = 'none';
        collapseIcon.style.transform = 'rotate(180deg)';
        console.log("[customer-ticket-client] Loaded collapsed state");
      }
    }

    // Toggle collapse/expand
    collapseButton?.addEventListener('click', () => {
      isCollapsed = !isCollapsed;
      
      console.log("[customer-ticket-client] Toggle collapse:", isCollapsed);

      if (isCollapsed) {
        // Collapse
        if (replyContainer && replyContent && collapseIcon) {
          replyContainer.style.height = COLLAPSED_HEIGHT;
          replyContent.style.display = 'none';
          collapseIcon.style.transform = 'rotate(180deg)';
          collapseButton.setAttribute('title', 'Expand reply area');
        }
      } else {
        // Expand
        const savedHeight = localStorage.getItem('replyAreaHeight') || '180';
        if (replyContainer && replyContent && collapseIcon) {
          replyContainer.style.height = `${savedHeight}px`;
          replyContent.style.display = 'flex';
          collapseIcon.style.transform = 'rotate(0deg)';
          collapseButton.setAttribute('title', 'Collapse reply area');
        }
      }

      // Save collapsed state
      localStorage.setItem('replyAreaCollapsed', isCollapsed.toString());
    });

    // ============================================================================
    // RESIZE FUNCTIONALITY
    // ============================================================================

    let isResizing = false;
    let startY = 0;
    let startHeight = 0;
    const MIN_HEIGHT = 150;
    const MAX_HEIGHT = 600;

    // Load saved height from localStorage
    const savedHeight = localStorage.getItem('replyAreaHeight');
    if (savedHeight && replyContainer) {
      const height = parseInt(savedHeight);
      if (height >= MIN_HEIGHT && height <= MAX_HEIGHT) {
        replyContainer.style.height = `${height}px`;
        console.log("[customer-ticket-client] Loaded saved height:", height);
      }
    }

    // Start resize
    resizeHandle?.addEventListener('mousedown', (e: MouseEvent) => {
      e.preventDefault();
      if(isCollapsed) return; // Prevent resizing when collapsed
      isResizing = true;
      startY = e.clientY;
      startHeight = replyContainer?.offsetHeight || 180;
      document.body.style.cursor = 'ns-resize';
      document.body.style.userSelect = 'none';
      
      console.log("[customer-ticket-client] Resize started at height:", startHeight);
    });

    // Handle resize
    document.addEventListener('mousemove', (e: MouseEvent) => {
      if (!isResizing || isCollapsed || !replyContainer) return;

      const deltaY = startY - e.clientY;
      const newHeight = Math.min(Math.max(startHeight + deltaY, MIN_HEIGHT), MAX_HEIGHT);
      
      replyContainer.style.height = `${newHeight}px`;
    });

    // End resize
    document.addEventListener('mouseup', () => {
      if(isCollapsed) return; // Prevent resizing when collapsed
      if (isResizing) {
        isResizing = false;
        document.body.style.cursor = '';
        document.body.style.userSelect = '';
        
        // Save height to localStorage
        if (replyContainer) {
          const currentHeight = replyContainer.offsetHeight;
          localStorage.setItem('replyAreaHeight', currentHeight.toString());
          console.log("[customer-ticket-client] Resize ended, height saved:", currentHeight);
        }
      }
    });

    // ============================================================================
    // MACRO FUNCTIONALITY
    // ============================================================================

    /**
     * Listen for macro selection events from React component
     * When a macro is chosen, append its text to the textarea
     */
    window.addEventListener('MacroChoosen', (e) => {
      console.log("[customer-ticket-client] MacroChoosen event received");
      
      const macrochoosen = e as CustomEvent;
      const text = macrochoosen?.detail?.text || '';
      
      if (!textarea || !text) {
        console.log("[customer-ticket-client] Missing textarea or text, skipping");
        return;
      }

      console.log("[customer-ticket-client] Appending macro text to textarea");

      // Append text to textarea (with newline if content exists)
      textarea.value += (textarea.value ? '\n\n' : '') + text;

      // Focus textarea and move cursor to end
      textarea.focus();
      const end = textarea.value.length;
      textarea.setSelectionRange(end, end);

      // Trigger input events for any listeners
      textarea.dispatchEvent(new Event('input', { bubbles: true }));
      textarea.dispatchEvent(new Event('change', { bubbles: true }));
    });

    // ============================================================================
    // Zuweisung FUNCTIONALITY
    // ============================================================================
    window.addEventListener('Zuweisung', async (e) => {
      console.log("[customer-ticket-client] Zuweisung event received");

      const zuweisung = e as CustomEvent;
      const employeeId = zuweisung?.detail?.text;
      const zuweisungElement = document.getElementById("Zuweisen");

      // Check for valid employeeId
      if (employeeId === undefined || employeeId === null) {
        console.log("[customer-ticket-client] Missing employeeId, skipping");
        return;
      }
      
      // Check for zuweisung element
      if (!zuweisungElement) {
        console.log("[customer-ticket-client] Zuweisung element not found, skipping");
        return;
      }
      const customerId = zuweisungElement.dataset.customerid;

      // Check for valid customerId
      if (!customerId) {
        console.log("[customer-ticket-client] Missing customerId, skipping");
        return;
      }

      await apiClient.post('/client/assignEmployee', {
        employee_id: parseInt(employeeId),
        customer_id: parseInt(customerId)
      });
    });


    // ============================================================================
    // AUTO-SCROLL MAIL LIST
    // ============================================================================

    /**
     * Auto-scroll mail list to bottom on page load
     * Shows the most recent messages first
     */
    (function () {
      console.log("[customer-ticket-client] Auto-scrolling email thread to bottom");
      const list = document.getElementById('emailThread');
      if (list) {
        list.scrollTop = list.scrollHeight;
        console.log("[customer-ticket-client] Email thread scrolled to:", list.scrollHeight);
      }
    })();

    // ============================================================================
    // SEND EMAIL FUNCTIONALITY
    // ============================================================================

    /**
     * Send button click handler
     * Sends the reply email and marks conversation as read
     */
    button?.addEventListener('click', async () => {
      console.log("[customer-ticket-client] Send button clicked");

      const emailAddress = button.dataset.email;
      const newSubject = button.dataset.subject;
      const customerId = button.dataset.customerid;
      const signature = button.dataset.signature;

      let body = textarea?.value || '';
      body = body.trim();

      console.log("[customer-ticket-client] Email data:", {
        to: emailAddress,
        subject: newSubject,
        customerId: customerId,
        bodyLength: body.length
      });

      // Disable button during send
      if (button) {
        button.setAttribute('disabled', 'true');
        button.innerHTML = `
          <svg class="mr-2 h-4 w-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Sending...
        `;
      }

      try {
        // Only send if there's content
        if (body.trim() !== '') {
          console.log("[customer-ticket-client] Sending email");

        await apiClient.post(`/api/emails/sendMail?customerId=${customerId}`, {
          to: emailAddress,
          subject: newSubject,
          text: body
        });

          console.log("[customer-ticket-client] Email sent successfully");
        } else {
          console.log("[customer-ticket-client] Empty message, skipping send");
        }
        
        // Mark conversation as read
        console.log("[customer-ticket-client] Marking conversation as read");
        await apiClient.post(`/api/emails/makeRead?customerId=${customerId}`);

        console.log("[customer-ticket-client] Redirecting to dashboard");
        window.location.href = '/dashboard';
      } catch (error) {
        console.error("[customer-ticket-client] Error sending email:", error);
        
        // Re-enable button on error
        if (button) {
          button.removeAttribute('disabled');
          button.innerHTML = `
            <svg class="mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
            </svg>
            Send Reply
          `;
        }
      }
    });


    declare global {
      interface Window {
        handleShowAttachment: (btn: HTMLButtonElement) => Promise<void> | void;
      }
    }
    export {};

    window.handleShowAttachment = async (btn) => {
      const mailId = btn.dataset.mail;
      const path   = btn.dataset.path?.trim();
      const mime   = btn.dataset.mime;
      const { data: sess } = await supabaseBrowser.auth.getSession();
      console.log('[client session?]', !!sess?.session);
      const preview = document.getElementById('emailThread');
      if (!preview) return;
      
      if (!path) {
        console.error('[attachment] missing path');
        return;
      }

      try {
        // Kurzlebige signierte URL erzeugen (z. B. 5 Minuten)
        const { data, error } = await supabaseBrowser
          .storage
          .from('mail-attachments')
          .createSignedUrl(path, 60 * 5);

        if (error || !data?.signedUrl) {
          throw new Error(error?.message || 'Signieren fehlgeschlagen');
        }

        const url = data.signedUrl;

        // Bilder inline zeigen, alles andere in neuem Tab öffnen
        if (mime && mime.startsWith('image/')) {
          const filename = path.split('/').pop();
          const list = document.getElementById('emailThread');
          let scrollHeight = 0;
          if (list) {
            scrollHeight = list.scrollTop;
          }
          preview.dataset.originalHtml = preview.innerHTML;
          preview.innerHTML = `
            <div class="inline-block bg-white border rounded-lg shadow-md overflow-hidden h-9/10 w-full">
              <div class="flex justify-between items-center px-2 py-1 bg-gray-50 border-b">
                <span class="text-xs font-medium text-gray-600 truncate">${filename}</span>
                <div class="flex gap-1">

                  <!-- Download -->
                  <button
                    id="download-${mailId}"
                    title="Download"
                    class="group relative h-9 w-9 flex items-center justify-center rounded-md bg-blue-600/80 hover:bg-blue-600 text-white shadow-md transition-transform hover:scale-105 active:scale-95"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M20 20H4"/>
                    </svg>
                    <span class="absolute -bottom-6 left-1/2 -translate-x-1/2 text-[10px] text-gray-700 bg-white/80 px-1.5 py-0.5 rounded opacity-0 group-hover:opacity-100 transition">
                      Download
                    </span>
                  </button>

                  <!-- Close -->
                  <button
                    id="close-preview-${mailId}"
                    title="Close"
                    class="group relative h-9 w-9 flex items-center justify-center rounded-md bg-gray-100/90 hover:bg-gray-200 text-gray-700 shadow-sm transition-transform hover:scale-105 active:scale-95"
                  >
                    ✕
                    <span class="absolute -bottom-6 left-1/2 -translate-x-1/2 text-[10px] text-gray-700 bg-white/80 px-1.5 py-0.5 rounded opacity-0 group-hover:opacity-100 transition">
                      Close
                    </span>
                  </button>
                </div>
              </div>
              <img
                src="${url}"
                alt="${filename}"
                class="block h-full w-full object-contain bg-gray-50"
                style="max-width:100%;"
              />
            </div>
          `;
          // Close-Button Event
          const closeBtn = document.getElementById(`close-preview-${mailId}`);
          if (closeBtn) {
            closeBtn.addEventListener('click', () => {
              // Alten Zustand wiederherstellen
              preview.innerHTML = preview.dataset.originalHtml || '';
              if (list) {
                list.scrollTop = scrollHeight;
              }
            });
          }

          // Download-Button Event
          const dlBtn = document.getElementById(`download-${mailId}`);
          if (dlBtn) {
            dlBtn.addEventListener('click', async () => {
              try {
                if (filename) {
                  // Datei per fetch holen (mit der signierten URL)
                  const res = await fetch(url);
                  if (!res.ok) throw new Error('Download fehlgeschlagen');
                  const blob = await res.blob();

                  // Temporären Download-Link erstellen
                  const blobUrl = URL.createObjectURL(blob);
                  const a = document.createElement('a');
                  a.href = blobUrl;
                  a.download = filename; // erzwingt Download
                  document.body.appendChild(a);
                  a.click();
                  a.remove();
                  URL.revokeObjectURL(blobUrl);
                }
                else {
                  alert('Es gab einen Fehler');
                }
              } catch (err) {
                console.error('[Download error]', err);
                alert('Download fehlgeschlagen');
              }
            });
          }
        } else {
          window.open(url, '_blank', 'noopener,noreferrer');
        }
      } catch (e : any) {
        console.error('[attachment]', e);
        alert('Fehler: ' + e.message);
      }
    };

    console.log("[customer-ticket-client] All event listeners attached");
  </script>
</BaseLayout>
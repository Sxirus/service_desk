---
/**
 * Customer Ticket Detail View
 * 
 * This page displays:
 * - Email conversation thread with a customer
 * - Customer information in the right sidebar
 * - Shopify order history (if store is connected)
 * - Macro search for quick responses
 * - Reply functionality (RESIZABLE & COLLAPSIBLE)
 * 
 * Security: Authenticated users only
 * Uses: Auth helper for DRY authentication/authorization
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../utils/formatDate.js";
import { TypeaheadSearch } from "../../components/macroSearch.jsx";
import { createClient } from "../../lib/supabase.ts";
import { getCompletePageContext } from "../../lib/auth-helpers.ts";
import AdminShell from "@/components/AdminShell";

console.log("[customer-ticket] Page accessed");

// ============================================================================
// ROUTE PARAMETERS
// ============================================================================

const { params } = Astro;
const customerId = params.customerId;

console.log("[customer-ticket] Customer ID:", customerId);

// ============================================================================
// AUTHENTICATION & AUTHORIZATION
// ============================================================================

const supabase = createClient({ 
  request: Astro.request, 
  cookies: Astro.cookies 
});

console.log("[customer-ticket] Verifying authentication");
const pageContext = await getCompletePageContext(supabase, Astro.cookies);

if (!pageContext) {
  console.error("[customer-ticket] Authentication failed, redirecting to login");
  return Astro.redirect("/");
}

const { authContext, sidebarData } = pageContext;

console.log("[customer-ticket] User authenticated:", {
  userId: authContext.user.id,
  employeeId: authContext.employee.id,
  clientId: authContext.employee.client_id
});

const clientId = authContext.employee.client_id;

// ============================================================================
// DATA LOADING
// ============================================================================

// Fetch customer data
console.log("[customer-ticket] Fetching customer data");
const resultCustomer = await fetch(`http://localhost:3000/api/customers/getCustomerById?customerId=${customerId}`);
const customerArray = await resultCustomer.json();
const customer = customerArray[0];

console.log("[customer-ticket] Customer loaded:", customer?.name);

// Fetch all emails for this customer
console.log("[customer-ticket] Fetching customer emails");
const resultMails = await fetch(`http://localhost:3000/api/emails/getEmailsFromCustomer?customerId=${customerId}`);
const emailArray = await resultMails.json();

let lastMail = emailArray[emailArray.length - 1];

// Fallback: wenn die letzte Mail nicht vom Kunden ist, such die letzte 'incoming'-Mail
if (lastMail?.type !== "incoming") {
  const incomingMails = emailArray.filter(m => m.type === "incoming");
  if (incomingMails.length > 0) {
    lastMail = incomingMails[incomingMails.length - 1];
  } else {
    console.warn("[customer-ticket] Keine eingehenden Mails gefunden, nutze letzte gesendete Mail");
  }
}

// Sicherstellen, dass lastMail existiert
if (!lastMail) {
  throw new Error("[customer-ticket] No emails found in the thread");
}

const emailAddress = lastMail.email_adress;
const newSubject = `RE: ${lastMail.subject}`;

console.log("[customer-ticket] Email thread loaded:", emailArray.length, "messages");

// Fetch macros for this client
console.log("[customer-ticket] Fetching macros for client:", clientId);
const resultMacros = await fetch(`http://localhost:3000/api/macros/getMacros?client_id=${clientId}`);
const macroArray = await resultMacros.json();

// Getting the signature
const resultSignature = await fetch(`http://localhost:3000/api/settings/getSignature?client_id=${clientId}`);
const signatureArray = await resultSignature.json();
const signature = signatureArray[0]?.email_signature || "";

console.log("[customer-ticket] Macros loaded:", macroArray?.length || 0);

// Fetch client data to check Shopify connection status
console.log("[customer-ticket] Fetching client data for Shopify integration");
const { data: clientData, error: clientError } = await supabase
  .from("clients")
  .select("id, name, shopify_store_url, shopify_access_token, shopify_connected, shopify_scope")
  .eq("id", clientId)
  .single();

if (clientError) {
  console.error("[customer-ticket] Error fetching client data:", clientError);
} else {
  console.log("[customer-ticket] Client data loaded:", {
    name: clientData?.name,
    shopifyConnected: clientData?.shopify_connected
  });
}

// Fetch Shopify orders if store is connected
let shopifyOrders = [];
let shopifyError = null;

if (clientData && clientData.shopify_connected) {
  console.log("[customer-ticket] Shopify is connected, fetching orders");
  try {
    const shopifyResponse = await fetch(
      `http://localhost:4321/api/shopify/getCustomerOrders?customerId=${customerId}`
    );
    const shopifyData = await shopifyResponse.json();
    
    if (shopifyData.error) {
      console.error("[customer-ticket] Shopify API error:", shopifyData.error);
      shopifyError = shopifyData.error;
    } else {
      shopifyOrders = shopifyData.orders || [];
      console.log("[customer-ticket] Shopify orders loaded:", shopifyOrders.length);
    }
  } catch (error) {
    console.error("[customer-ticket] Exception fetching Shopify orders:", error);
    shopifyError = "Failed to load orders";
  }
} else {
  console.log("[customer-ticket] Shopify not connected, skipping order fetch");
}

console.log("[customer-ticket] Page setup complete, rendering");
---

<BaseLayout title={customer?.name || "Customer Ticket"}>
  <AdminShell 
    client:load
    user={sidebarData.user}
    firstTeam={sidebarData.team ?? undefined}
    crumbParentLabel="Dashboard"
    crumbParentHref="/dashboard"
    crumbCurrent={customer?.name || "Ticket"}
    isAdmin={authContext.isAdmin}
    currentPath={`/tickets/${customerId}`}
  >
    <div class="flex gap-6 h-[calc(100vh-5rem)] -mx-6 -mb-6 overflow-hidden">
      <!-- Main Content Area - Email Thread -->
      <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <!-- Page Header -->
        <div class="px-6 mt-2 pt-0 py-2">
          <h1 class="text-2xl font-bold tracking-tight">Conversation with {customer?.name}</h1>
        </div>

        <!-- Email Thread -->
        <div class="flex-1 px-6 overflow-y-auto overflow-x-hidden">
          <div id="mailList" class="space-y-4 pb-4">
            {emailArray.map((mail: any) => {
              const isOutgoing = mail.type === 'sent';
              
              return (
                <div class={`rounded-lg border ${
                  isOutgoing 
                    ? 'bg-blue-50 border-blue-200' 
                    : 'bg-card border-border'
                } shadow-sm`}>
                  <div class="p-4">
                    <!-- Message Header -->
                    <div class="flex items-start justify-between mb-3">
                      <div class="flex items-center gap-2">
                        <div class={`flex h-8 w-8 items-center justify-center rounded-full ${
                          isOutgoing ? 'bg-blue-600' : 'bg-muted'
                        }`}>
                          <svg
                            class={`h-4 w-4 ${isOutgoing ? 'text-white' : 'text-muted-foreground'}`}
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"
                            />
                          </svg>
                        </div>
                        <div>
                          <p class={`text-sm font-semibold ${
                            isOutgoing ? 'text-blue-900' : 'text-foreground'
                          }`}>
                            {isOutgoing ? 'You' : customer?.name || 'Customer'}
                          </p>
                          <p class="text-xs text-muted-foreground">
                            {isOutgoing ? 'Support Agent' : 'Customer'}
                          </p>
                        </div>
                      </div>
                      <time class="text-xs text-muted-foreground">
                        {formatDate(mail.date)}
                      </time>
                    </div>

                    <!-- Message Body -->
                    <div class="text-sm text-foreground whitespace-pre-wrap leading-relaxed" style="word-break: break-word; overflow-wrap: anywhere;">
                      {mail.text}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        <!-- Reply Area (Resizable & Collapsible) -->
        <div id="replyContainer" class="border-t bg-card flex flex-col" style="min-height: 52px; height: 180px;">
          <!-- Resize Handle -->
          <div
            id="resizeHandle"
            class="h-1.5 bg-border hover:bg-primary cursor-ns-resize transition-colors relative group flex-shrink-0"
            title="Drag to resize"
          >
            <div class="absolute inset-x-0 -top-2 -bottom-2"></div>
          </div>
          
          <!-- Header with Collapse Button -->
          <div class="flex items-center justify-between px-6 pt-3 pb-2 flex-shrink-0">
            <label for="answer" class="text-sm font-medium leading-none">
              Your Reply
            </label>
            <button
              id="collapseButton"
              type="button"
              class="inline-flex items-center justify-center h-8 w-8 rounded-md hover:bg-accent transition-colors"
              title="Collapse reply area"
            >
              <svg
                id="collapseIcon"
                class="h-4 w-4 transition-transform duration-200"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 8.25l-7.5 7.5-7.5-7.5"
                />
              </svg>
            </button>
          </div>

          <!-- Reply Content -->
          <div id="replyContent" class="px-6 pb-4 flex-1 flex flex-col min-h-0">
            <div class="flex gap-3 items-end h-full">
              <textarea
                id="answer"
                class="flex-1 h-full min-h-0 rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 resize-none"
                placeholder="Type your reply..."
              ></textarea>
              <button
                data-email={emailAddress}
                data-subject={newSubject}
                data-customerid={customerId}
                data-signature={signature}
                id="sendButton"
                type="button"
                class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2 flex-shrink-0"
              >
                <svg
                  class="mr-2 h-4 w-4"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5"
                  />
                </svg>
                Send Reply
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Sidebar -->
      <div class="w-80 flex-shrink-0 border-l bg-muted/30 flex flex-col overflow-hidden">
        <div class="flex-1 overflow-y-auto p-6 space-y-6">
          
          <!-- Customer Information Card -->
          <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
            <div class="p-4 space-y-3">
              <h3 class="font-semibold leading-none tracking-tight">
                Customer Information
              </h3>
              <div class="space-y-2">
                <div>
                  <p class="text-xs text-muted-foreground">Name</p>
                  <p class="text-sm font-medium">{customer?.name}</p>
                </div>
                <div>
                  <p class="text-xs text-muted-foreground">Email</p>
                  <p class="text-sm font-medium text-blue-600" style="word-break: break-word; overflow-wrap: anywhere;">{emailAddress}</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Order History Card -->
          {clientData && clientData.shopify_connected ? (
            <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
              <div class="p-4 space-y-3">
                <h3 class="font-semibold leading-none tracking-tight">
                  Order History
                </h3>
                
                {shopifyError ? (
                  <div class="rounded-lg border border-destructive/50 bg-destructive/10 p-3">
                    <p class="text-xs text-destructive">Failed to load orders</p>
                  </div>
                ) : shopifyOrders.length > 0 ? (
                  <div class="space-y-2 max-h-96 overflow-y-auto">
                    {shopifyOrders.slice(0, 10).map((order: any) => (
                      <div class="rounded-lg border bg-background p-3 hover:bg-accent transition-colors">
                        <!-- Order Header -->
                        <div class="flex justify-between items-start mb-2">
                          <div>
                            <p class="text-sm font-semibold">
                              Order #{order.order_number}
                            </p>
                            <p class="text-xs text-muted-foreground">
                              {new Date(order.created_at).toLocaleDateString('en-US', {
                                year: 'numeric',
                                month: 'short',
                                day: 'numeric'
                              })}
                            </p>
                          </div>
                          <!-- Financial Status Badge -->
                          <span class={`text-xs px-2 py-1 rounded-full font-medium ${
                            order.financial_status === 'paid' 
                              ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' 
                              : order.financial_status === 'pending'
                              ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200'
                              : order.financial_status === 'refunded'
                              ? 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200'
                              : 'bg-muted text-muted-foreground'
                          }`}>
                            {order.financial_status}
                          </span>
                        </div>

                        <!-- Order Details -->
                        <div class="space-y-2">
                          <!-- Total Price -->
                          <div class="flex justify-between items-center">
                            <span class="text-xs text-muted-foreground">Total:</span>
                            <span class="text-sm font-semibold">
                              {order.total_price} {order.currency}
                            </span>
                          </div>

                          {/* Fulfillment Status */}
                          {order.fulfillment_status && (
                            <div class="flex justify-between items-center">
                              <span class="text-xs text-muted-foreground">Fulfillment:</span>
                              <span class={`text-xs px-2 py-0.5 rounded ${
                                order.fulfillment_status === 'fulfilled'
                                  ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200'
                                  : order.fulfillment_status === 'partial'
                                  ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200'
                                  : 'bg-muted text-muted-foreground'
                              }`}>
                                {order.fulfillment_status}
                              </span>
                            </div>
                          )}

                          {/* Item Count */}
                          {order.line_items && order.line_items.length > 0 && (
                            <div class="mt-2 pt-2 border-t">
                              <p class="text-xs text-muted-foreground mb-1">
                                {order.line_items.length} item{order.line_items.length !== 1 ? 's' : ''}
                              </p>
                              <ul class="space-y-1">
                                {order.line_items.slice(0, 2).map((item: any) => (
                                  <li class="text-xs">
                                    • {item.quantity}x {item.name}
                                  </li>
                                ))}
                                {order.line_items.length > 2 && (
                                  <li class="text-xs text-muted-foreground italic">
                                    + {order.line_items.length - 2} more
                                  </li>
                                )}
                              </ul>
                            </div>
                          )}

                          {/* View in Shopify Link */}
                          {order.id && (
                            <div class="mt-2 pt-2 border-t">
                              <a
                                href={`https://${clientData.shopify_store_url}/admin/orders/${order.id}`}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-xs text-primary hover:underline font-medium flex items-center gap-1"
                              >
                                View in Shopify
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                </svg>
                              </a>
                            </div>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                ) : (
                  <div class="rounded-lg border bg-muted p-3 text-center">
                    <p class="text-xs text-muted-foreground">
                      No orders found for this customer
                    </p>
                  </div>
                )}
              </div>
            </div>
          ) : (
            <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
              <div class="p-4 space-y-3">
                <h3 class="font-semibold leading-none tracking-tight">
                  Order History
                </h3>
                <div class="rounded-lg border bg-muted p-3 text-center">
                  <p class="text-xs text-muted-foreground">
                    Shopify not connected
                  </p>
                  <p class="text-xs text-muted-foreground mt-1">
                    Connect your store in settings to view orders
                  </p>
                </div>
              </div>
            </div>
          )}

          <!-- Quick Responses Card -->
          <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
            <div class="p-4 space-y-3">
              <h3 class="font-semibold leading-none tracking-tight">
                Quick Responses
              </h3>
              <TypeaheadSearch
                client:load
                items={macroArray}
                placeholder="Search macros..."
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </AdminShell>

  <script>
    console.log("[customer-ticket-client] Client-side script initialized");

    // ============================================================================
    // GET DOM ELEMENTS
    // ============================================================================
    
    const textarea = document.getElementById('answer') as HTMLTextAreaElement;
    const button = document.getElementById('sendButton') as HTMLButtonElement;
    const replyContainer = document.getElementById('replyContainer') as HTMLElement;
    const resizeHandle = document.getElementById('resizeHandle') as HTMLElement;
    const collapseButton = document.getElementById('collapseButton') as HTMLElement;
    const collapseIcon = document.getElementById('collapseIcon') as HTMLElement;
    const replyContent = document.getElementById('replyContent') as HTMLElement;

    console.log("[customer-ticket-client] DOM elements found:", {
      textarea: !!textarea,
      button: !!button,
      replyContainer: !!replyContainer,
      resizeHandle: !!resizeHandle,
      collapseButton: !!collapseButton
    });

    // ============================================================================
    // RESIZE FUNCTIONALITY
    // ============================================================================

    let isResizing = false;
    let startY = 0;
    let startHeight = 0;
    const MIN_HEIGHT = 100;
    const MAX_HEIGHT = 600;

    // Load saved height from localStorage
    const savedHeight = localStorage.getItem('replyAreaHeight');
    if (savedHeight && replyContainer) {
      const height = parseInt(savedHeight);
      if (height >= MIN_HEIGHT && height <= MAX_HEIGHT) {
        replyContainer.style.height = `${height}px`;
        console.log("[customer-ticket-client] Loaded saved height:", height);
      }
    }

    // Start resize
    resizeHandle?.addEventListener('mousedown', (e: MouseEvent) => {
      e.preventDefault();
      isResizing = true;
      startY = e.clientY;
      startHeight = replyContainer?.offsetHeight || 180;
      document.body.style.cursor = 'ns-resize';
      document.body.style.userSelect = 'none';
      
      console.log("[customer-ticket-client] Resize started at height:", startHeight);
    });

    // Handle resize
    document.addEventListener('mousemove', (e: MouseEvent) => {
      if (!isResizing || !replyContainer) return;

      const deltaY = startY - e.clientY;
      const newHeight = Math.min(Math.max(startHeight + deltaY, MIN_HEIGHT), MAX_HEIGHT);
      
      replyContainer.style.height = `${newHeight}px`;
    });

    // End resize
    document.addEventListener('mouseup', () => {
      if (isResizing) {
        isResizing = false;
        document.body.style.cursor = '';
        document.body.style.userSelect = '';
        
        // Save height to localStorage
        if (replyContainer) {
          const currentHeight = replyContainer.offsetHeight;
          localStorage.setItem('replyAreaHeight', currentHeight.toString());
          console.log("[customer-ticket-client] Resize ended, height saved:", currentHeight);
        }
      }
    });

    // ============================================================================
    // COLLAPSE/EXPAND FUNCTIONALITY
    // ============================================================================

    let isCollapsed = false;
    const COLLAPSED_HEIGHT = '52px';
    
    // Load saved collapsed state
    const savedCollapsedState = localStorage.getItem('replyAreaCollapsed');
    
    if (savedCollapsedState === 'true') {
      isCollapsed = true;
      if (replyContainer && replyContent && collapseIcon) {
        replyContainer.style.height = COLLAPSED_HEIGHT;
        replyContent.style.display = 'none';
        collapseIcon.style.transform = 'rotate(180deg)';
        console.log("[customer-ticket-client] Loaded collapsed state");
      }
    }

    // Toggle collapse/expand
    collapseButton?.addEventListener('click', () => {
      isCollapsed = !isCollapsed;
      
      console.log("[customer-ticket-client] Toggle collapse:", isCollapsed);

      if (isCollapsed) {
        // Collapse
        if (replyContainer && replyContent && collapseIcon) {
          replyContainer.style.height = COLLAPSED_HEIGHT;
          replyContent.style.display = 'none';
          collapseIcon.style.transform = 'rotate(180deg)';
          collapseButton.setAttribute('title', 'Expand reply area');
        }
      } else {
        // Expand
        const savedHeight = localStorage.getItem('replyAreaHeight') || '180';
        if (replyContainer && replyContent && collapseIcon) {
          replyContainer.style.height = `${savedHeight}px`;
          replyContent.style.display = 'flex';
          collapseIcon.style.transform = 'rotate(0deg)';
          collapseButton.setAttribute('title', 'Collapse reply area');
        }
      }

      // Save collapsed state
      localStorage.setItem('replyAreaCollapsed', isCollapsed.toString());
    });

    // ============================================================================
    // MACRO FUNCTIONALITY
    // ============================================================================

    /**
     * Listen for macro selection events from React component
     * When a macro is chosen, append its text to the textarea
     */
    window.addEventListener('MacroChoosen', (e) => {
      console.log("[customer-ticket-client] MacroChoosen event received");
      
      const macrochoosen = e as CustomEvent;
      const text = macrochoosen?.detail?.text || '';
      
      if (!textarea || !text) {
        console.log("[customer-ticket-client] Missing textarea or text, skipping");
        return;
      }

      console.log("[customer-ticket-client] Appending macro text to textarea");

      // Append text to textarea (with newline if content exists)
      textarea.value += (textarea.value ? '\n\n' : '') + text;

      // Focus textarea and move cursor to end
      textarea.focus();
      const end = textarea.value.length;
      textarea.setSelectionRange(end, end);

      // Trigger input events for any listeners
      textarea.dispatchEvent(new Event('input', { bubbles: true }));
      textarea.dispatchEvent(new Event('change', { bubbles: true }));
    });

    // ============================================================================
    // AUTO-SCROLL MAIL LIST
    // ============================================================================

    /**
     * Auto-scroll mail list to bottom on page load
     * Shows the most recent messages first
     */
    (function () {
      console.log("[customer-ticket-client] Auto-scrolling mail list to bottom");
      const list = document.getElementById('mailList');
      if (list) {
        list.scrollTop = list.scrollHeight;
        console.log("[customer-ticket-client] Mail list scrolled to:", list.scrollHeight);
      }
    })();

    // ============================================================================
    // SEND EMAIL FUNCTIONALITY
    // ============================================================================

    /**
     * Send button click handler
     * Sends the reply email and marks conversation as read
     */
    button?.addEventListener('click', async () => {
      console.log("[customer-ticket-client] Send button clicked");

      const emailAddress = button.dataset.email;
      const newSubject = button.dataset.subject;
      const customerId = button.dataset.customerid;
      const signature = button.dataset.signature;

      let body = textarea?.value || '';
      body = body.trim() ? body + '\n\n' + (signature || '') : (signature || '');

      console.log("[customer-ticket-client] Email data:", {
        to: emailAddress,
        subject: newSubject,
        customerId: customerId,
        bodyLength: body.length
      });

      // Disable button during send
      if (button) {
        button.setAttribute('disabled', 'true');
        button.innerHTML = `
          <svg class="mr-2 h-4 w-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Sending...
        `;
      }

      try {
        // Only send if there's content
        if (body.trim() !== '') {
          console.log("[customer-ticket-client] Sending email");
          
          await fetch(`http://localhost:3000/api/emails/sendMail?customerId=${customerId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ to: emailAddress, subject: newSubject, text: body }),
          });

          console.log("[customer-ticket-client] Email sent successfully");
        } else {
          console.log("[customer-ticket-client] Empty message, skipping send");
        }

        // Mark conversation as read
        console.log("[customer-ticket-client] Marking conversation as read");
        await fetch(`http://localhost:3000/api/emails/makeRead?customerId=${customerId}`, { 
          method: 'POST' 
        });

        console.log("[customer-ticket-client] Redirecting to dashboard");
        window.location.href = '/dashboard';
      } catch (error) {
        console.error("[customer-ticket-client] Error sending email:", error);
        
        // Re-enable button on error
        if (button) {
          button.removeAttribute('disabled');
          button.innerHTML = `
            <svg class="mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
            </svg>
            Send Reply
          `;
        }
      }
    });

    console.log("[customer-ticket-client] All event listeners attached");
  </script>
</BaseLayout>
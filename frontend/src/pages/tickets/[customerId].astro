---
/**
 * Customer Ticket Detail View
 * 
 * This page displays:
 * - Email conversation thread with a customer
 * - Customer information in the right sidebar
 * - Shopify order history (if store is connected)
 * - Macro search for quick responses
 * - Reply functionality
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../utils/formatDate.js";
import { TypeaheadSearch } from "../../components/macroSearch.jsx";
import { createClient } from "../../lib/supabase.ts";

console.log("[TICKET_VIEW] Loading ticket view");

// Get route parameters
const { params } = Astro;
const customerId = params.customerId;

console.log("[TICKET_VIEW] Customer ID:", customerId);

// Get query parameters
const url = Astro.url;
const clientId = parseInt(url.searchParams.get('clientId') ?? 'null');

console.log("[TICKET_VIEW] Client ID from query:", clientId);

// Initialize Supabase client for database access
const supabase = createClient({ request: Astro.request, cookies: Astro.cookies });

// Fetch customer data
console.log("[TICKET_VIEW] Fetching customer data");
const resultCustomer = await fetch(`http://localhost:3000/api/customers/getCustomerById?customerId=${customerId}`);
const customerArray = await resultCustomer.json();
const customer = customerArray[0];

console.log("[TICKET_VIEW] Customer loaded:", customer?.name);

// Fetch all emails for this customer
console.log("[TICKET_VIEW] Fetching customer emails");
const resultMails = await fetch(`http://localhost:3000/api/emails/getEmailsFromCustomer?customerId=${customerId}`);
const emailArray = await resultMails.json();

// Find the last incoming mail to determine reply-to address and subject
var lastMail = emailArray[emailArray.length - 1];
if (lastMail['type'] != 'incoming') {
  for (let mail of emailArray) {
    if (mail.type == 'incoming') {
      lastMail = mail;
    }
  }
}

const emailAdress = lastMail.email_adress;
const newSubject = `RE: ${lastMail.subject}`;

console.log("[TICKET_VIEW] Email thread loaded:", emailArray.length, "messages");

// Fetch macros for this client
console.log("[TICKET_VIEW] Fetching macros for client:", clientId);
const resultMacros = await fetch(`http://localhost:3000/api/macros/getMacros?client_id=${clientId}`);
const macroArray = await resultMacros.json();

console.log("[TICKET_VIEW] Macros loaded:", macroArray?.length || 0);

// Fetch client data to check Shopify connection status
console.log("[TICKET_VIEW] Fetching client data for Shopify integration");
const { data: clientData, error: clientError } = await supabase
  .from("clients")
  .select("id, name, shopify_store_url, shopify_access_token, shopify_connected, shopify_scope")
  .eq("id", clientId)
  .single();

if (clientError) {
  console.error("[TICKET_VIEW] Error fetching client data:", clientError);
} else {
  console.log("[TICKET_VIEW] Client data loaded:", {
    name: clientData?.name,
    shopifyConnected: clientData?.shopify_connected
  });
}

// Fetch Shopify orders if store is connected
let shopifyOrders = [];
let shopifyError = null;

if (clientData && clientData.shopify_connected) {
  console.log("[TICKET_VIEW] Shopify is connected, fetching orders");
  try {
    const shopifyResponse = await fetch(
      `http://localhost:4321/api/shopify/getCustomerOrders?customerId=${customerId}`
    );
    const shopifyData = await shopifyResponse.json();
    
    if (shopifyData.error) {
      console.error("[TICKET_VIEW] Shopify API error:", shopifyData.error);
      shopifyError = shopifyData.error;
    } else {
      shopifyOrders = shopifyData.orders || [];
      console.log("[TICKET_VIEW] Shopify orders loaded:", shopifyOrders.length);
    }
  } catch (error) {
    console.error("[TICKET_VIEW] Exception fetching Shopify orders:", error);
    shopifyError = "Failed to load orders";
  }
} else {
  console.log("[TICKET_VIEW] Shopify not connected, skipping order fetch");
}

console.log("[TICKET_VIEW] Page data preparation complete");
---

<BaseLayout title={customer.name} overflowHidden>
  <!-- Right Sidebar -->
  <div class="fixed right-0 bg-gray-100 h-full w-1/5 outline-2 outline-gray-300 flex flex-col overflow-y-auto">
    
    <!-- Customer Information Section -->
    <div class="p-4 border-b border-gray-300">
      <h3 class="text-sm font-semibold text-gray-700 mb-3">Customer Information</h3>
      <ul class="space-y-2">
        <li class="text-sm">
          <span class="text-gray-600">Name:</span>
          <span class="ml-2 font-medium">{customer.name}</span>
        </li>
        <li class="text-sm">
          <span class="text-gray-600">Email:</span>
          <span class="ml-2 font-medium text-blue-600">{emailAdress}</span>
        </li>
      </ul>
    </div>

    <!-- Shopify Orders Section -->
    {clientData && clientData.shopify_connected ? (
      <div class="p-4 border-b border-gray-300">
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Order History</h3>
        
        {shopifyError ? (
          <div class="bg-red-50 border border-red-200 rounded p-3">
            <p class="text-xs text-red-600">Failed to load orders</p>
          </div>
        ) : shopifyOrders.length > 0 ? (
          <div class="space-y-2 max-h-96 overflow-y-auto">
            {shopifyOrders.slice(0, 10).map((order: any) => (
              <div class="bg-white rounded-lg p-3 shadow-sm border border-gray-200 hover:border-blue-300 transition-colors">
                {/* Order Header */}
                <div class="flex justify-between items-start mb-2">
                  <div>
                    <p class="text-sm font-semibold text-gray-900">
                      Order #{order.order_number}
                    </p>
                    <p class="text-xs text-gray-500">
                      {new Date(order.created_at).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                      })}
                    </p>
                  </div>
                  {/* Financial Status Badge */}
                  <span class={`text-xs px-2 py-1 rounded-full font-medium ${
                    order.financial_status === 'paid' 
                      ? 'bg-green-100 text-green-800' 
                      : order.financial_status === 'pending'
                      ? 'bg-yellow-100 text-yellow-800'
                      : order.financial_status === 'refunded'
                      ? 'bg-red-100 text-red-800'
                      : 'bg-gray-100 text-gray-800'
                  }`}>
                    {order.financial_status}
                  </span>
                </div>

                {/* Order Details */}
                <div class="space-y-1">
                  {/* Total Price */}
                  <div class="flex justify-between items-center">
                    <span class="text-xs text-gray-600">Total:</span>
                    <span class="text-sm font-semibold text-gray-900">
                      {order.total_price} {order.currency}
                    </span>
                  </div>

                  {/* Fulfillment Status */}
                  {order.fulfillment_status && (
                    <div class="flex justify-between items-center">
                      <span class="text-xs text-gray-600">Fulfillment:</span>
                      <span class={`text-xs px-2 py-0.5 rounded ${
                        order.fulfillment_status === 'fulfilled'
                          ? 'bg-green-100 text-green-800'
                          : order.fulfillment_status === 'partial'
                          ? 'bg-yellow-100 text-yellow-800'
                          : 'bg-gray-100 text-gray-800'
                      }`}>
                        {order.fulfillment_status}
                      </span>
                    </div>
                  )}

                  {/* Item Count */}
                  {order.line_items && order.line_items.length > 0 && (
                    <div class="mt-2 pt-2 border-t border-gray-200">
                      <p class="text-xs text-gray-600">
                        {order.line_items.length} item{order.line_items.length !== 1 ? 's' : ''}
                      </p>
                      {/* Show first 2 items */}
                      <ul class="mt-1 space-y-1">
                        {order.line_items.slice(0, 2).map((item: any) => (
                          <li class="text-xs text-gray-700">
                            • {item.quantity}x {item.name}
                          </li>
                        ))}
                        {order.line_items.length > 2 && (
                          <li class="text-xs text-gray-500 italic">
                            + {order.line_items.length - 2} more
                          </li>
                        )}
                      </ul>
                    </div>
                  )}

                  {/* View in Shopify Link */}
                  {order.id && (
                    <div class="mt-2 pt-2 border-t border-gray-200">
                      <a
                        href={`https://${clientData.shopify_store_url}/admin/orders/${order.id}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-xs text-blue-600 hover:text-blue-800 font-medium flex items-center gap-1"
                      >
                        View in Shopify
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      </a>
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="bg-gray-50 border border-gray-200 rounded p-3">
            <p class="text-xs text-gray-600 text-center">No orders found for this customer</p>
          </div>
        )}
      </div>
    ) : (
      <div class="p-4 border-b border-gray-300">
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Order History</h3>
        <div class="bg-gray-50 border border-gray-200 rounded p-3">
          <p class="text-xs text-gray-600 text-center">
            Shopify not connected
          </p>
          <p class="text-xs text-gray-500 text-center mt-1">
            Connect your store in settings to view orders
          </p>
        </div>
      </div>
    )}

    <!-- Macro Search Section -->
    <div class="p-4 border-b border-gray-300 flex-grow">
      <h3 class="text-sm font-semibold text-gray-700 mb-3">Quick Responses</h3>
      <TypeaheadSearch
        client:load
        items={macroArray}
        placeholder="Search macros..."
      />
    </div>

    <!-- Send Button (Sticky at bottom) -->
    <div class="p-4 bg-white border-t border-gray-300 sticky bottom-0">
      <button
        data-email={emailAdress}
        data-subject={newSubject}
        data-customerid={customerId}
        id="sendButton"
        class="w-full bg-blue-600 text-white px-4 py-3 rounded-lg hover:bg-blue-700 transition-colors font-medium"
      >
        Send Reply
      </button>
    </div>
  </div>

  <!-- Email Thread Section (Left Side) -->
  <div class="relative w-4/5 h-screen flex flex-col">
    <!-- Email Subject Header -->
    <h1 class="text-4xl font-bold w-full p-4 border-b border-gray-200">{lastMail.subject}</h1>

    <!-- Email List -->
    <ul id="mailList" class="flex-1 overflow-y-auto p-4 space-y-4">
      {emailArray.map((mail: any) => {
        if (mail.type == 'sent') {
          return (
            <li class="bg-blue-50 border-l-4 border-blue-500 rounded p-4">
              <div class="flex justify-between items-start mb-2">
                <p class="text-sm font-semibold text-blue-900">Employee</p>
                <p class="text-xs text-gray-600">{formatDate(mail.date)}</p>
              </div>
              <p class="text-sm text-gray-800 whitespace-pre-wrap">{mail.text}</p>
            </li>
          );
        }
        return (
          <li class="bg-white border-l-4 border-gray-300 rounded p-4 shadow-sm">
            <div class="flex justify-between items-start mb-2">
              <p class="text-sm font-semibold text-gray-900">Customer</p>
              <p class="text-xs text-gray-600">{formatDate(mail.date)}</p>
            </div>
            <p class="text-sm text-gray-800 whitespace-pre-wrap">{mail.text}</p>
          </li>
        );
      })}
    </ul>

    <!-- Reply Textarea (Sticky at bottom) -->
    <div class="sticky bottom-0 bg-white border-t border-gray-200 p-4">
      <textarea
        id="answer"
        class="w-full h-40 resize-none p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
        placeholder="Type your reply..."
      ></textarea>
    </div>
  </div>

  <script>
    console.log("[TICKET_VIEW_CLIENT] Client-side script initialized");

    // Get DOM elements
    const textarea = document.getElementById('answer') as HTMLTextAreaElement;
    const button = document.getElementById('sendButton');

    console.log("[TICKET_VIEW_CLIENT] DOM elements found:", {
      textarea: !!textarea,
      button: !!button
    });

    /**
     * Listen for macro selection events from React component
     * When a macro is chosen, append its text to the textarea
     */
    window.addEventListener('MacroChoosen', (e) => {
      console.log("[TICKET_VIEW_CLIENT] MacroChoosen event received");
      
      const macrochoosen = e as CustomEvent;
      const text = macrochoosen?.detail?.text || '';
      
      if (!textarea || !text) {
        console.log("[TICKET_VIEW_CLIENT] Missing textarea or text, skipping");
        return;
      }

      console.log("[TICKET_VIEW_CLIENT] Appending macro text to textarea");

      // Append text to textarea (with newline if content exists)
      textarea.value += (textarea.value ? '\n\n' : '') + text;

      // Focus textarea and move cursor to end
      textarea.focus();
      const end = textarea.value.length;
      textarea.setSelectionRange(end, end);

      // Trigger input events for any listeners
      textarea.dispatchEvent(new Event('input', { bubbles: true }));
      textarea.dispatchEvent(new Event('change', { bubbles: true }));
    });

    /**
     * Auto-scroll mail list to bottom on page load
     * Shows the most recent messages first
     */
    (function () {
      console.log("[TICKET_VIEW_CLIENT] Auto-scrolling mail list to bottom");
      const list = document.getElementById('mailList');
      if (list) {
        list.scrollTop = list.scrollHeight;
        console.log("[TICKET_VIEW_CLIENT] Mail list scrolled to:", list.scrollHeight);
      }
    })();

    /**
     * Send button click handler
     * Sends the reply email and marks conversation as read
     */
    button?.addEventListener('click', async () => {
      console.log("[TICKET_VIEW_CLIENT] Send button clicked");

      const emailAdress = button.dataset.email;
      const newSubject = button.dataset.subject;
      const customerId = button.dataset.customerid;
      const body = textarea?.value || '';

      console.log("[TICKET_VIEW_CLIENT] Email data:", {
        to: emailAdress,
        subject: newSubject,
        customerId: customerId,
        bodyLength: body.length
      });

      // Only send if there's content
      if (body.trim() !== '') {
        console.log("[TICKET_VIEW_CLIENT] Sending email");
        
        await fetch(`http://localhost:3000/api/emails/sendMail?customerId=${customerId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ to: emailAdress, subject: newSubject, text: body }),
        });

        console.log("[TICKET_VIEW_CLIENT] Email sent successfully");
      } else {
        console.log("[TICKET_VIEW_CLIENT] Empty message, skipping send");
      }

      // Mark conversation as read
      console.log("[TICKET_VIEW_CLIENT] Marking conversation as read");
      await fetch(`http://localhost:3000/api/emails/makeRead?customerId=${customerId}`, { 
        method: 'POST' 
      });

      console.log("[TICKET_VIEW_CLIENT] Redirecting to inbox");
      window.location.assign('/');
    });

    console.log("[TICKET_VIEW_CLIENT] All event listeners attached");
  </script>
</BaseLayout>
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../utils/formatDate.js";
import { TypeaheadSearch } from "../../components/macroSearch.jsx";
//parameters (pfad)
const { params } = Astro;
const customerId = params.customerId;

//parameter(query)
const url = Astro.url;
const clientId = parseInt(url.searchParams.get('clientId') ?? 'null');

//getting the customer
const resultCustomer = await fetch(`http://localhost:3000/api/customers/getCustomerById?customerId=${customerId}`);
const customerArray = await resultCustomer.json();
const customer = customerArray[0];

//getting all the emails from a customer
const resultMails = await fetch(`http://localhost:3000/api/emails/getEmailsFromCustomer?customerId=${customerId}`);
const emailArray = await resultMails.json()
var lastMail = emailArray[emailArray.length - 1];
if (lastMail['type'] != 'incoming'){
  for (let mail of emailArray) {
    if (mail.type == 'incoming') {
      lastMail = mail;
    };
};
};
const emailAdress = lastMail.email_adress;
const newSubject = `RE: ${lastMail.subject}`

//getting macros per client
const resultMacros = await fetch (`http://localhost:3000/api/macros/getMacros?client_id=${clientId}`);
const macroArray = await resultMacros.json();

//getting the signature
const resultSignature = await fetch (`http://localhost:3000/api/settings/getSignature?client_id=${clientId}`);
const signatureArray = await resultSignature.json();
const signature = signatureArray[0].email_signature;
---

<BaseLayout title={customer.name} overflowHidden>
  <!-- the right side -->
  <div class="fixed right-0 bg-gray-100 h-full w-1/5 outline-2 outline-gray-300 flex flex-col justify-between mb-52 items-center">
    <ul class="w-full">
      <li class="flex justify-center m-3">
        Name: {customer.name}
      </li>
      <li class="flex justify-center m-3">{emailAdress}</li>
    </ul>

    <div class="m-3 flex w-full size">   
      <TypeaheadSearch
      client:load
      items={macroArray}          
      placeholder="Makro-Titel suchen…"   
      />
    </div>

    <button
      data-email={emailAdress}
      data-subject={newSubject}
      data-customerid={customerId}
      id="sendButton"
      class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 sticky bottom-7 w-4/5 hover:cursor-pointer">
      Senden
    </button>
  </div>
  
  <!-- all the mails of the customer -->
  <div class="relative w-4/5 h-screen flex flex-col">
  <h1 class="text-6xl w-full h-[5%] m-4">{lastMail.subject}</h1>

  <ul id="mailList" class="flex-1 overflow-y-auto mb-2">
    {emailArray.map((mail: any) => {
      if (mail.type == 'sent') return (
        <li class="outline-2 outline-gray-300 mb-2">
          <p>{formatDate(mail.date)}</p>
          <p>Employee</p>
          <p class="text-black">{mail.text}</p>
        </li>
      );
      return (
        <li class="outline-2 outline-gray-300 mb-2">
          <p>{formatDate(mail.date)}</p>
          <p>Customer</p>
          <p class="text-black">{mail.text}</p>
        </li>
      );
    })}
  </ul>

  <!-- Sticky Footer: Suche + Textfeld sichtbar am unteren Rand -->
  <div class="sticky bottom-0 bg-white border-t p-2">
    <textarea
      id="answer"
      class="mt-2 w-full h-60 resize-none overflow-y-auto p-2 border border-gray-300"
      placeholder="Answer..."
    ></textarea>
  </div>
</div>



  <script>
    // Elemente holen
    /** @type {HTMLTextAreaElement|null} */
    const textarea = document.getElementById('answer') as HTMLTextAreaElement;
    /** @type {HTMLButtonElement|null} */
    const button = document.getElementById('sendButton');

    // ✅ React-Event empfangen und Text anhängen
    window.addEventListener('MacroChoosen', (e) => {
      const macrochoosen = e as CustomEvent;
      const text = macrochoosen?.detail?.text || '';
      if (!textarea || !text) return;

      // hier: mit Zeilenumbruch anhängen (oder ersetze "\n" durch " ")
      textarea.value += (textarea.value ? '' : '') + text;

      // Cursor ans Ende
      textarea.focus();
      const end = textarea.value.length;
      textarea.setSelectionRange(end, end);

      // Falls andere Listener zuhören
      textarea.dispatchEvent(new Event('input', { bubbles: true }));
      textarea.dispatchEvent(new Event('change', { bubbles: true }));
    });

    // Mail-Liste nach unten scrollen
    (function () {
      const list = document.getElementById('mailList');
      if (list) list.scrollTop = list.scrollHeight;
    })();

    // Senden-Button
    button?.addEventListener('click', async () => {
      const emailAdress = button.dataset.email;
      const newSubject = button.dataset.subject;
      const customerId = button.dataset.customerid;

      const body = textarea?.value || '';
      if (body.trim() !== '') {
        await fetch(`http://localhost:3000/api/emails/sendMail?customerId=${customerId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ to: emailAdress, subject: newSubject, text: body }),
        });
      }

      await fetch(`http://localhost:3000/api/emails/makeRead?customerId=${customerId}`, { method: 'POST' });
      window.location.assign('/');
    });
  </script>
</BaseLayout>

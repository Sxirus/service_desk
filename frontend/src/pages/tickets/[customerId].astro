---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../utils/formatDate.js";
//parameters
const { params } = Astro;
const customerId = params.customerId;
//getting the customer
const resultCustomer = await fetch(`http://localhost:3000/api/customers/getCustomerById?customerId=${customerId}`);
const customerArray = await resultCustomer.json();
const customer = customerArray[0];
//getting all the emails from a customer
const resultMails = await fetch(`http://localhost:3000/api/emails/getEmailsFromCustomer?customerId=${customerId}`);
const emailArray = await resultMails.json()
var lastMail = emailArray[emailArray.length - 1];
if (lastMail['type'] != 'incoming'){
  for (let mail of emailArray) {
    if (mail.type == 'incoming') {
      lastMail = mail;
    };
};
};
const emailAdress = lastMail.email_adress;
const newSubject = `RE: ${lastMail.subject}`
---

<BaseLayout title={customer.name} overflowHidden>
  <!-- the right side -->
  <div class="fixed right-0 bg-gray-100 h-full w-1/5 outline outline-2 outline-gray-300 flex justify-center">
    <ul>
    <li>
      Name: {customer.name}
    </li>
    <li>{emailAdress}</li>
    </ul>
    <button
      data-email={emailAdress}
      data-subject={newSubject}
      data-customerid={customerId}
      id="sendButton"
      class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 absolute bottom-7 w-4/5">
      Senden
    </button>
  </div>
  
  <!-- all the mails of the customer -->
  <div class="relative w-4/5 h-screen">
    <h1 class="text-6xl w-full h-[5%] m-4">{lastMail.subject}</h1>
    <ul id='mailList' class="w-full h-[70%] overflow-y-auto mb-2">
      {emailArray.map((mail: any) => {
      if (mail.type == 'sent') return (      
      <li class="outline outline-2 outline-gray-300 mb-2">
        <p>{formatDate(mail.date)}</p>
        <p>Employee</p> 
        <p class="text-black">{mail.text}</p>
      </li>);
      return (
      <li class="outline outline-2 outline-gray-300 mb-2">
        <p>{formatDate(mail.date)}</p>
        <p>Customer</p>
        <p class="text-black">{mail.text}</p>
      </li>
    )})}
    </ul>
    <!-- Text field to write text for new mail -->
    <textarea class="w-full h-[20%] absolut bottom-3 resize-none overflow-y-auto p-2 border border-gray-300" placeholder="Answer..." id="answer"></textarea>
  </div>

  <script>
    //mail list standartmäßig nach unten gescrollt
    document.addEventListener('DOMContentLoaded', () => {
      const list = document.getElementById('mailList');
      if (list) {
        list.scrollTop = list.scrollHeight; // ganz nach unten springen
      }
    });

    //button functionalität
    document.addEventListener('DOMContentLoaded', () => {
      const button = document.getElementById('sendButton') as HTMLButtonElement;
      const textarea = document.getElementById('answer') as HTMLTextAreaElement;

      //send button action
      button?.addEventListener('click', async() => {
        const emailAdress = button.dataset.email;
        const newSubject = button.dataset.subject;
        const customerId = button.dataset.customerid;

        const body = textarea.value;
        if(body.trim() != '') {
          //sending mail
          await fetch(`http://localhost:3000/api/emails/sendMail?customerId=${customerId}`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              to: emailAdress,
              subject: newSubject,
              text: body,
            }),
          });
        }
        //making all mails read
        var result = await fetch(`http://localhost:3000/api/emails/makeRead?customerId=${customerId}`, {
          method: 'POST'
        });
        //change window to main screen
        window.location.assign('/');
      });
    });
  </script>
</BaseLayout>

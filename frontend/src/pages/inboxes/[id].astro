---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminShell from "../../components/AdminShell";
import { createClient } from "../../lib/supabase";
import { getCompletePageContext } from "../../lib/auth-helpers";

// Initialize Supabase client
const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies
});

// Get authentication context
const pageContext = await getCompletePageContext(supabase, Astro.cookies);

if (!pageContext) {
  return Astro.redirect("/");
}

const { authContext, sidebarData } = pageContext;

// Get session for API calls
const { data: { session } } = await supabase.auth.getSession();
if (!session) {
  return Astro.redirect("/");
}

const inboxId = Astro.params.id;

if (!inboxId) {
  return Astro.redirect("/inboxes");
}

// Fetch inbox details
let inbox = null;
let emails = [];
let error = null;

try {
  const inboxResponse = await fetch(
    `http://localhost:3000/api/inboxes/getAccessibleInboxes`,
    {
      headers: {
        Authorization: `Bearer ${session.access_token}`,
        "Content-Type": "application/json",
      },
    }
  );

  if (inboxResponse.ok) {
    const result = await inboxResponse.json();
    inbox = result.data.find((i: any) => i.id === parseInt(inboxId));
    
    if (!inbox) {
      error = "Inbox not found or access denied";
    }
  } else {
    error = "Failed to load inbox";
  }

  // Fetch emails for this inbox
  if (inbox) {
    const emailsResponse = await fetch(
      `http://localhost:3000/api/inboxes/getInboxEmails?inbox_id=${inboxId}`,
      {
        headers: {
          Authorization: `Bearer ${session.access_token}`,
          "Content-Type": "application/json",
        },
      }
    );

    if (emailsResponse.ok) {
      const emailsResult = await emailsResponse.json();
      emails = emailsResult.data || [];
    }
  }
} catch (err) {
  console.error("Error loading inbox:", err);
  error = "Failed to load inbox data";
}
---

<BaseLayout title={inbox ? inbox.name : "Inbox"}>
  <AdminShell
    client:load
    user={sidebarData.user}
    firstTeam={sidebarData.team ?? undefined}
    crumbParentLabel="Inboxes"
    crumbParentHref="/inboxes"
    crumbCurrent={inbox ? inbox.name : "Inbox"}
    isAdmin={authContext.isAdmin}
    currentPath={`/inboxes/${inboxId}`}
  >
    <div class="container mx-auto px-4 py-6">
    {error ? (
      <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg">
        {error}
      </div>
    ) : inbox ? (
      <div>
        <div class="mb-6">
          <h1 class="text-3xl font-bold mb-2">{inbox.name}</h1>
          {inbox.description && (
            <p class="text-gray-600">{inbox.description}</p>
          )}
          <div class="mt-2 text-sm text-gray-500">
            {emails.length} email{emails.length !== 1 ? "s" : ""}
          </div>
        </div>

        <div class="bg-white rounded-lg shadow">
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead class="bg-gray-50 border-b">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Subject
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    From
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Customer
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Assigned To
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Date
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Status
                  </th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                {emails.map((email: any) => (
                  <tr class="hover:bg-gray-50 cursor-pointer" onclick={`window.location.href='/tickets/${email.customer_id}'`}>
                    <td class="px-6 py-4">
                      <div class={`font-medium ${!email.read ? 'font-bold text-gray-900' : 'text-gray-700'}`}>
                        {email.subject || "(No Subject)"}
                      </div>
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-600">
                      {email.email_address}
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-600">
                      {email.customers?.name || "Unknown"}
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-600">
                      {email.customers?.employees?.name ? (
                        <span class="inline-flex items-center gap-1">
                          <span>👤</span>
                          <span>{email.customers.employees.name}</span>
                        </span>
                      ) : email.customers?.employee_groups?.name ? (
                        <span class="inline-flex items-center gap-1">
                          <span>👥</span>
                          <span>{email.customers.employee_groups.name}</span>
                        </span>
                      ) : (
                        <span class="text-gray-400">Unassigned</span>
                      )}
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-600">
                      {new Date(email.send_at).toLocaleString()}
                    </td>
                    <td class="px-6 py-4 text-sm">
                      <span class={`inline-flex px-2 py-1 text-xs font-semibold rounded-full ${
                        email.read 
                          ? 'bg-gray-100 text-gray-800' 
                          : 'bg-blue-100 text-blue-800'
                      }`}>
                        {email.read ? 'Read' : 'Unread'}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            {emails.length === 0 && (
              <div class="text-center py-12 text-gray-500">
                <svg class="w-16 h-16 mx-auto mb-4 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
                <p>No emails in this inbox</p>
              </div>
            )}
          </div>
        </div>
      </div>
    ) : (
      <div>Loading...</div>
    )}
  </AdminShell>
</BaseLayout>

---
/**
 * Platform Notifications Page
 * View all platform notifications (cancellations, payment failures, etc.)
 */

import Layout from "../../layouts/BaseLayout.astro";
import { createClient } from "../../lib/supabase.ts";
import { getPlatformOnlyContext, getCompletePageContext } from "../../lib/auth-helpers.ts";
import PlatformShell from "@/components/platform/PlatformShell";
import NotificationsManagement from "@/components/platform/NotificationsManagement";
import { getTranslations, getLanguageFromCookies } from "@/i18n/astro";

// Get translations
const lang = getLanguageFromCookies(Astro.cookies);
const { t } = getTranslations(lang, 'platform');
const tCommon = getTranslations(lang, 'common');

// Initialize Supabase client
const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

console.log("[platform-notifications] Page accessed");

// Check authentication
let user: { id: string; email: string } | null = null;
let platformAdminId: string | null = null;
let hasClientLink = false;
let clientName: string | undefined;

const pageContext = await getCompletePageContext(supabase, Astro.cookies);
if (pageContext && pageContext.isPlatformAdmin) {
  user = pageContext.authContext.user;
  hasClientLink = true;
  clientName = pageContext.sidebarData.team?.name;
  
  // Get platform admin ID
  const { data: admin } = await supabase
    .from("platform_admins")
    .select("id")
    .eq("user_id", user.id)
    .single();
  platformAdminId = admin?.id;
} else {
  const platformContext = await getPlatformOnlyContext(supabase, Astro.cookies);
  if (platformContext) {
    user = platformContext.user;
    platformAdminId = platformContext.platformAdmin.id;
    hasClientLink = false;
  }
}

if (!user || !platformAdminId) {
  console.error("[platform-notifications] Not a platform admin, redirecting");
  return Astro.redirect("/");
}

// Get session for API calls
const { data: { session } } = await supabase.auth.getSession();
if (!session) {
  console.error("[platform-notifications] No session, redirecting");
  return Astro.redirect("/");
}

// Fetch initial notifications from backend API
let notifications: any[] = [];
let unreadCount = 0;
try {
  const response = await fetch("http://localhost:3000/api/platform/notifications?limit=50", {
    headers: {
      "Authorization": `Bearer ${session.access_token}`,
      "Content-Type": "application/json"
    }
  });

  if (response.ok) {
    const result = await response.json();
    notifications = result.data || [];
    unreadCount = result.unread_count || 0;
    console.log("[platform-notifications] Loaded", notifications.length, "notifications");
  } else {
    console.error("[platform-notifications] API error:", response.status);
  }
} catch (error) {
  console.error("[platform-notifications] Failed to fetch notifications:", error);
}
---

<Layout title={t('pages.notifications.pageTitle')}>
  <PlatformShell
    client:load
    user={{ email: user.email }}
    crumbParentLabel={tCommon.t('sidebar.platform')}
    crumbParentHref="/platform"
    crumbCurrent={t('sidebar.notifications')}
    currentPath="/platform/notifications"
    hasClientLink={hasClientLink}
    clientName={clientName}
  >
    <NotificationsManagement 
      client:load
      initialNotifications={notifications || []}
      initialUnreadCount={unreadCount}
    />
  </PlatformShell>
</Layout>

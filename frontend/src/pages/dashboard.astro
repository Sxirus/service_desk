---
import BaseLayout from "../layouts/BaseLayout.astro";
import { createClient } from "../lib/supabase.ts";
import { getCompletePageContext } from "../lib/auth-helpers.ts";
import { serverApiCall } from "../utils/api.ts";
import { NewEmailPopover } from "@/components/NewEmailPopover";
import { getTranslations, getLanguageFromCookies } from "@/i18n/astro";

// Get translations
const lang = getLanguageFromCookies(Astro.cookies);
const { t } = getTranslations(lang, 'common');
const { t: tDash } = getTranslations(lang, 'dashboard');

// Sidebar Shell
import AdminShell from "@/components/AdminShell";
import LimitBanner from "@/components/LimitBanner";
import { TicketsDataTableWithPresence } from "@/components/datatable/TicketsDataTableWithPresence";

// Create Supabase client with server-side rendering support
const supabase = createClient({
    request: Astro.request,
    cookies: Astro.cookies,
});

// Use canonical auth helper instead of inline manual auth (normalised auth pattern)
const pageContext = await getCompletePageContext(supabase, Astro.cookies);
if (!pageContext) return Astro.redirect("/");

const { authContext, sidebarData, isPlatformAdmin } = pageContext;

// Get session for server-side API calls
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/");

// Fetch emails from the API for the individual employee
let customersJSON: any[] = [];
let mails: any[] = [];

try {
  const customersResponse = await serverApiCall(
    `/customers/getAssignedCustomers?employee_id=${authContext.employee.id}`,
    session.access_token
  );
  customersJSON = customersResponse.data || [];
} catch { /* no assigned customers */ }

const customers: number[] = customersJSON.map((c: any) => c.id);

if (customers.length > 0) {
  try {
    const qs = customers.map(id => `ids=${encodeURIComponent(id)}`).join("&");
    const mailResponse = await serverApiCall(
      `/emails/getMailsbyCustomerIds?${qs}`,
      session.access_token
    );
    mails = (mailResponse.data || []).map((mail: any) => ({
      ...mail,
      customer_name: mail.customers?.name || 'Unknown',
      status: mail.status || 'new'
    }));
  } catch { /* no mails */ }
}

// Current user info for presence tracking
const currentUserForPresence = {
  id: String(authContext.employee.id),
  name: sidebarData.user.name || 'Support Agent',
  avatar_url: sidebarData.user.avatarUrl || null
};
---

<BaseLayout title={t('pages.dashboard.pageTitle')}>
  <AdminShell client:load
    user={sidebarData.user}
    firstTeam={sidebarData.team ?? undefined}
    crumbParentLabel={t('serviceDesk')}
    crumbParentHref="/"
    crumbCurrent={t('yourAssignedTickets')}
    isAdmin={authContext.isAdmin}
    isPlatformAdmin={isPlatformAdmin}
    currentPath="/dashboard"
    employeeId={sidebarData.employeeId}
    clientId={sidebarData.clientId}
    subscriptionTier={sidebarData.subscriptionTier}
  >
    <div class="space-y-6">
      <!-- Limit Banner -->
      <LimitBanner client:load tier={sidebarData.subscriptionTier} />

      <!-- My Tickets Section -->
      <div class="bg-white mt-4 rounded-lg shadow-sm border p-6">
        <div class="mb-4 flex items-start justify-between gap-4">
          <div>
            <h2 class="text-xl font-semibold">{t('pages.dashboard.assignedTickets')}</h2>
            <p class="text-sm text-gray-600 mt-1">{t('pages.dashboard.ticketsAssigned', { count: mails.length })}</p>
          </div>
          <NewEmailPopover client:load from="dashboard" />
        </div>
        
        <TicketsDataTableWithPresence 
          client:load
          data={mails}
          showAssignedColumn={false}
          tableId="dashboard"
          currentUser={currentUserForPresence}
        />
      </div>
    </div>
  </AdminShell>
</BaseLayout>
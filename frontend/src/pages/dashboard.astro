---
import BaseLayout from "../layouts/BaseLayout.astro";
import { createClient } from "../lib/supabase.ts";

// Sidebar Shell
import AdminShell from "@/components/AdminShell";
import LimitBanner from "@/components/LimitBanner";

// Create Supabase client with server-side rendering support
const supabase = createClient({
    request: Astro.request,
    cookies: Astro.cookies,
});

// Get the currently authenticated user
const { data: { user }, error: userErr } = await supabase.auth.getUser();
if (userErr || !user) return Astro.redirect("/");

// Get session for API calls
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/");

// "me" ermitteln. Erst RPC, sonst Fallback
let me: { id: number; client_id: number } | null = null;

try {
  const rpc = await supabase.rpc("get_my_employee").single();
  if (!rpc.error) me = rpc.data as any;
} catch {}

if (!me) {
  const res = await supabase
    .from("employees")
    .select("id, client_id")
    .eq("user_id", user.id)
    .single();
  me = res.data as any;
  if (res.error) {
    console.error("[dashboard] employees lookup:", res.error.message);
  }
}

if (!me) return Astro.redirect("/");

// Fetch emails from the database for the individual employee
const client_id = me.client_id;

// SERVER-SIDE API CALL with auth token
// Note: Remove client_id from query - it comes from the auth token now
const result_customers = await fetch(`http://localhost:3000/api/customers/getAssignedCustomers?employee_id=${me.id}`, {
  headers: {
    'Authorization': `Bearer ${session.access_token}`,
    'Content-Type': 'application/json'
  }
});
const customersJSON = await result_customers.json();
const len = customersJSON.length;
var customers: number[] = [];
for (let i = 0; i < len; i++) {
  var customer_id = customersJSON[i].id;
  customers.push(customer_id);
}

console.log(customers);
const qs = customers.map(id => `ids=${encodeURIComponent(id)}`).join("&");
console.log(qs);

// SERVER-SIDE API CALL with auth token
const mailresult = await fetch(`http://localhost:3000/api/emails/getMailsbyCustomerIds?${qs}`, {
  headers: {
    'Authorization': `Bearer ${session.access_token}`,
    'Content-Type': 'application/json'
  }
});
const mails = await mailresult.json();

// Admin Rolle prüfen. Rolle 1 = admin
const { data: myRoles, error: rolesErr } = await supabase
  .from("roles-employees")
  .select("role_id")
  .eq("employee_id", me.id);

if (rolesErr) {
  console.error("[dashboard] roles lookup:", rolesErr.message);
}

const isAdmin = !!myRoles?.some((r) => r.role_id === 1);

// Mitarbeiter-Info für Sidebar
const { data: employees, error: empsErr } = await supabase
  .from("employees")
  .select("id, name")
  .eq("client_id", me.client_id)
  .order("name");

if (empsErr) console.error("[dashboard] employees list:", empsErr.message);

// Sidebar Infos
const meName = employees?.find((e) => e.id === me?.id)?.name ?? user?.email ?? "Nutzer";
const sidebarUser = {
  name: meName,
  email: user?.email ?? null,
  avatarUrl: null,
};

// Team Eintrag
let firstTeam = null as null | { name: string; plan?: string | null };
let subscriptionTier = 'free';
try {
  const { data: clientRow } = await supabase
    .from("clients")
    .select("id, name, subscription_tier")
    .eq("id", me.client_id)
    .single();
  if (clientRow?.name) {
    firstTeam = { name: clientRow.name, plan: "Enterprise" };
  }
  if (clientRow?.subscription_tier) {
    subscriptionTier = clientRow.subscription_tier;
  }
} catch {}
---

<BaseLayout title="Service Desk">
  <AdminShell client:load
    user={sidebarUser}
    firstTeam={firstTeam ?? undefined}
    crumbParentLabel="Service Desk"
    crumbParentHref="/"
    crumbCurrent="Dashboard"
    isAdmin={isAdmin}
    currentPath="/dashboard"
  >
    <div class="space-y-6">
      <!-- Limit Banner -->
      <LimitBanner client:load tier={subscriptionTier} />
      
      <!-- Header Section -->
      <div class="flex justify-between items-center">
        <h1 class="text-3xl font-bold">Dashboard</h1>
      </div>

      <!-- User Info Card -->
      <div class="bg-white p-6 rounded-lg shadow-sm border">
        <h2 class="text-xl font-semibold mb-4">Willkommen, {meName}!</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-gray-600">
          <div>
            <span class="font-medium">User ID:</span> {user.id}
          </div>
          <div>
            <span class="font-medium">E-Mail:</span> {user.email}
          </div>
          <div>
            <span class="font-medium">Rolle:</span> {isAdmin ? "Administrator" : "Benutzer"}
          </div>
          <div>
            <span class="font-medium">Team:</span> {firstTeam?.name ?? "Nicht zugeordnet"}
          </div>
        </div>
      </div>

      <!-- Quick Actions Section (optional) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-lg shadow-sm border">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <svg class="h-8 w-8 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="ml-4">
              <dt class="text-sm font-medium text-gray-500 truncate">Gesamte E-Mails</dt>
              <dd class="text-2xl font-semibold text-gray-900">{mails.length}</dd>
            </div>
          </div>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-sm border">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <svg class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div class="ml-4">
              <dt class="text-sm font-medium text-gray-500 truncate">Status</dt>
              <dd class="text-2xl font-semibold text-gray-900">Aktiv</dd>
            </div>
          </div>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-sm border">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <svg class="h-8 w-8 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <div class="ml-4">
              <dt class="text-sm font-medium text-gray-500 truncate">Rolle</dt>
              <dd class="text-lg font-semibold text-gray-900">{isAdmin ? "Admin" : "User"}</dd>
            </div>
          </div>
        </div>
      </div>

      <!-- Recent Emails Section -->
      <div class="bg-white rounded-lg shadow-sm border">
        <div class="px-6 py-4 border-b">
          <h2 class="text-xl font-semibold">Aktuelle E-Mails</h2>
          <p class="text-sm text-gray-600 mt-1">Die 10 neuesten E-Mails</p>
        </div>
        
        <div class="p-6">
          {mails.length > 0 ? (
            <ul class="space-y-3">
              {mails.map((mail: any) => (
                <li class="group">
                  <a 
                    href={`/tickets/${mail.customer_id}`}
                    class="flex items-center p-4 border border-gray-200 rounded-lg hover:border-gray-300 hover:bg-gray-50 transition-colors group-hover:shadow-sm"
                  >
                    <div class="flex-1 overflow-hidden">
                      <div class="font-medium text-gray-900 truncate">
                        {mail.subject}
                      </div>
                      <div class="text-sm text-gray-500 mt-1">
                        Kunde ID: {mail.customer_id}
                      </div>
                    </div>
                    <div class="ml-4">
                      <svg class="w-5 h-5 text-gray-400 group-hover:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                      </svg>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <div class="text-center py-12">
              <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <h3 class="mt-4 text-lg font-medium text-gray-900">Keine E-Mails vorhanden</h3>
              <p class="mt-2 text-gray-500">Es sind momentan keine E-Mails verfügbar.</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </AdminShell>
</BaseLayout>
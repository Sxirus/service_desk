---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InboxManagementPanel from "../../components/InboxManagementPanel";
import AdminShell from "../../components/AdminShell";
import { createClient } from "../../lib/supabase";
import { getCompletePageContext } from "../../lib/auth-helpers";
import { getTranslations, getLanguageFromCookies } from "@/i18n/astro";

// Get translations
const lang = getLanguageFromCookies(Astro.cookies);
const { t } = getTranslations(lang, 'manage');
const tCommon = getTranslations(lang, 'common');

// Initialize Supabase client
const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies
});

// Get authentication context
const pageContext = await getCompletePageContext(supabase, Astro.cookies);

if (!pageContext) {
  return Astro.redirect("/");
}

const { authContext, sidebarData } = pageContext;

// Verify admin role
if (!authContext.isAdmin) {
  return Astro.redirect("/dashboard");
}

// Get session for API calls
const { data: { session } } = await supabase.auth.getSession();
if (!session) {
  return Astro.redirect("/");
}

// Fetch groups using Supabase directly
let groups: Array<{ id: number; name: string }> = [];
try {
  const { data: groupsData, error: groupsError } = await supabase
    .from("employee_groups")
    .select("id, name")
    .eq("client_id", authContext.employee.client_id)
    .order("name");

  if (groupsError) {
    console.error('[inboxes] Failed to load groups:', groupsError);
  } else {
    groups = (groupsData || []).map(g => ({ id: Number(g.id), name: g.name }));
    console.log('[inboxes] Loaded', groups.length, 'groups');
  }
} catch (error) {
  console.error('Failed to load groups:', error);
}
---

<BaseLayout title={t('pages.inboxes.pageTitle')}>
  <AdminShell
    client:load
    user={sidebarData.user}
    firstTeam={sidebarData.team ?? undefined}
    crumbParentLabel={tCommon.t('sidebar.administration')}
    crumbParentHref="/manage"
    crumbCurrent={t('pages.inboxes.pageTitle')}
    isAdmin={authContext.isAdmin}
    isPlatformAdmin={pageContext.isPlatformAdmin}
    currentPath="/manage/inboxes"
    employeeId={sidebarData.employeeId}
    clientId={sidebarData.clientId}
    subscriptionTier={sidebarData.subscriptionTier}
  >
    <div class="space-y-8">
      <!-- Page Header -->
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="space-y-1 mt-2">
          <h1 class="text-2xl font-semibold tracking-tight">{t('pages.inboxes.heading')}</h1>
          <p class="text-sm text-muted-foreground">
            {t('pages.inboxes.description')}
          </p>
        </div>
      </div>

      <InboxManagementPanel client:load groups={groups} />
    </div>
  </AdminShell>
</BaseLayout>

---
import Layout from "../../layouts/BaseLayout.astro";
import { createClient } from "../../lib/supabase.ts";
import { actions } from "astro:actions";

const supabase = createClient({ request: Astro.request, cookies: Astro.cookies });

console.log("[admin-panel] accessed");

// Verifizierter User (nicht nur Session!)
const { data: { user }, error: userErr } = await supabase.auth.getUser();
if (userErr || !user) return Astro.redirect("/");

// "me" (Employee) holen – zuerst per RPC (falls vorhanden), sonst Fallback-Select
let me: { id: number; client_id: number } | null = null;

try {
  const rpc = await supabase.rpc("get_my_employee").single();
  if (!rpc.error) me = rpc.data as any;
} catch {}

if (!me) {
  const res = await supabase
    .from("employees")
    .select("id, client_id")
    .eq("user_id", user.id)
    .single();
  me = res.data as any;
  if (res.error) {
    console.error("[admin-panel] employees lookup:", res.error.message);
  }
}

if (!me) return Astro.redirect("/");

// Admin-Rolle prüfen (rolle 1 = admin)
const { data: myRoles, error: rolesErr } = await supabase
  .from("roles-employees")
  .select("role_id")
  .eq("employee_id", me.id);

if (rolesErr) {
  console.error("[admin-panel] roles lookup:", rolesErr.message);
  return new Response("Forbidden", { status: 403 });
}

const isAdmin = !!myRoles?.some((r) => r.role_id === 1);
if (!isAdmin) return new Response("Forbidden", { status: 403 });

// Rollen, Mitarbeiter, Zuordnungen laden
const { data: roleRows, error: rolesListErr } = await supabase
  .from("roles")
  .select("id, name")
  .order("id");

if (rolesListErr) console.error("[admin-panel] roles list:", rolesListErr.message);

const { data: employees, error: empsErr } = await supabase
  .from("employees")
  .select("id, name")
  .eq("client_id", me.client_id)
  .order("name");

if (empsErr) console.error("[admin-panel] employees list:", empsErr.message);

const { data: rels, error: relsErr } = await supabase
  .from("roles-employees") // keine Anführungszeichen im JS
  .select("employee_id, role_id");

if (relsErr) console.error("[admin-panel] roles-employees list:", relsErr.message);

function rolesFor(empId: number) {
  const map = new Map<number, number[]>();
  rels?.forEach((r) => {
    if (!map.has(r.employee_id)) map.set(r.employee_id, []);
    map.get(r.employee_id)!.push(r.role_id);
  });
  return map.get(empId) ?? [];
}
---

<Layout>
  <h1 class="text-2xl mb-4">Nutzer verwalten</h1>

  <form id="addEmployeeForm"
        method="post"
        action={actions.createEmployee}
        class="flex gap-2 mb-6">
    <input name="email" type="email" placeholder="E-Mail" required class="border p-2 rounded" />
    <input name="name" type="text" placeholder="Name" required class="border p-2 rounded" />
    <select name="role_id" class="border p-2 rounded">
      {roleRows?.map((r) => <option value={r.id}>{r.name}</option>)}
    </select>
    <button type="submit" id="create-employee" class="bg-gray-700 text-white px-3 py-2 rounded">
      Benutzer anlegen
    </button>
  </form>

  <table class="w-full text-left border-collapse">
    <thead>
      <tr>
        <th class="border-b p-2">Name</th>
        <th class="border-b p-2">Rollen</th>
      </tr>
    </thead>
    <tbody>
      {employees?.map((e) => (
        <tr>
          <td class="border-b p-2">{e.name}</td>
          <td class="border-b p-2">
            {rolesFor(e.id).map((rid) => roleRows?.find((r) => r.id === rid)?.name).join(", ")}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</Layout>

<script type="module">
  import { actions } from "astro:actions";

  const form = document.getElementById("addEmployeeForm");
  const btn  = document.getElementById("create-employee");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = "Mitarbeiter wird angelegt…";

    try {
      const formData = new FormData(form);
      const result = await actions.createEmployee(formData);

      if (!result?.data?.success) {
        alert(result?.data?.message ?? "Fehler beim Anlegen");
        btn.disabled = false;
        btn.textContent = "Benutzer anlegen";
        return;
      }

      const url = new URL(location.href);
        url.search = ''; // it reset the search params
        location.href = url.toString();


      // Erfolgreich → Liste aktualisieren
      location.reload();
    } catch (err) {
      console.error(err);
      alert("Unerwarteter Fehler");
      btn.disabled = false;
      btn.textContent = "Benutzer anlegen";

            const url = new URL(location.href);
        url.search = ''; // it reset the search params
        location.href = url.toString();
    }
  });
</script>

---
import Layout from "../../layouts/BaseLayout.astro";
import { createClient } from "../../lib/supabase.ts";
import AdminShell from "@/components/AdminShell";

const supabase = createClient({ request: Astro.request, cookies: Astro.cookies });

console.log("[admin-panel] accessed");

// Verifizierter User
const { data: { user }, error: userErr } = await supabase.auth.getUser();
if (userErr || !user) return Astro.redirect("/");

// "me" ermitteln. Erst RPC, sonst Fallback
let me: { id: number; client_id: number } | null = null;

try {
  const rpc = await supabase.rpc("get_my_employee").single();
  if (!rpc.error) me = rpc.data as any;
} catch {}

if (!me) {
  const res = await supabase
    .from("employees")
    .select("id, client_id")
    .eq("user_id", user.id)
    .single();
  me = res.data as any;
  if (res.error) {
    console.error("[admin-panel] employees lookup:", res.error.message);
  }
}

if (!me) return Astro.redirect("/");

// Admin Rolle prüfen. Rolle 1 = admin
const { data: myRoles, error: rolesErr } = await supabase
  .from("roles-employees")
  .select("role_id")
  .eq("employee_id", me.id);

if (rolesErr) {
  console.error("[admin-panel] roles lookup:", rolesErr.message);
  return new Response("Forbidden", { status: 403 });
}

const isAdmin = !!myRoles?.some((r) => r.role_id === 1);
if (!isAdmin) return new Response("Forbidden", { status: 403 });

// Company-Daten laden
const { data: companyData, error: companyErr } = await supabase
  .from("clients")
  .select("id, name")
  .eq("id", me.client_id)
  .single();

if (companyErr) {
  console.error("[admin-panel] company lookup:", companyErr.message);
}

// Sidebar Infos
const { data: employees } = await supabase
  .from("employees")
  .select("id, name")
  .eq("client_id", me.client_id)
  .order("name");

const meName = employees?.find((e) => e.id === me?.id)?.name ?? user?.email ?? "Nutzer";
const sidebarUser = {
  name: meName,
  email: user?.email ?? null,
  avatarUrl: null,
};

// Team Eintrag
const firstTeam = companyData?.name 
  ? { name: companyData.name, plan: "Enterprise" } 
  : null;

// getting the email signature
const resultSignature = await fetch (`http://localhost:3000/api/settings/getSignature?client_id=${me.client_id}`);
const signatureArray = await resultSignature.json();
const signature = signatureArray[0].email_signature;
---
<Layout>
  <AdminShell client:load
    user={sidebarUser}
    firstTeam={firstTeam ?? undefined}
    crumbParentLabel="Administration"
    crumbParentHref="/manage"
    crumbCurrent="Company"
    isAdmin={isAdmin}
    currentPath="/manage/client"
  >
  <div class="space-y-6">
    <!-- header -->
    <div>
      <h1 class="text-3xl font-bold tracking-tight">General Settings</h1>
      <p class="text-muted-foreground">Manage the settings and preferences for the service desk</p>
    </div>
    <!-- email signature setting -->
    <div class="flex flex-col">
      <h1>E-Mail signature</h1>
      <textarea id="signature" class="resize-none overflow-y-auto border border-gray-300 w-full h-30">{signature}</textarea>
      <button data-client_id={me.client_id} id="save" class="bg-black text-white hover:cursor-pointer self-end mt-4 mr-4 py-2 px-2 rounded-lg">Save</button>
    </div>
  </div>
  </AdminShell>

  <script>
    const button = document.getElementById("save");
    const signatureArea = document.getElementById("signature") as HTMLTextAreaElement;
    console.log('updating signature')
    button?.addEventListener('click', async () => {
      const client_id = button.dataset.client_id;
      const signature = signatureArea?.value || ''

      await fetch(`http://localhost:3000/api/settings/updateSignature?client_id=${client_id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({signature: signature}),
       });
    });
  </script>
</Layout>
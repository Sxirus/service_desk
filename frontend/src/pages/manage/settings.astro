---
// src/pages/manage/settings.astro

/**
 * General Settings Page
 * Allows admin users to manage service desk settings and preferences
 * 
 * Security: Admin-only access (role_id = 1)
 * Uses: Auth helper for DRY authentication/authorization
 * 
 * Features:
 * - Email signature management with XSS protection
 * - Email sending configuration (primary email & mode)
 * - Additional settings can be added here
 */

import Layout from "../../layouts/BaseLayout.astro";
import { createClient } from "../../lib/supabase.ts";
import { getCompletePageContext } from "../../lib/auth-helpers.ts";
import ToggleSwitch from "@/components/ToggleSwitch";
import SettingsSignatureEditor from "@/components/SettingsSignatureEditor";
import SettingsConfirmMailEditor from "@/components/SettingsConfirmMailEditor";
import ConfirmMailModeSelector from "@/components/ConfirmMailModeSelector";
import { getTranslations, getLanguageFromCookies } from "@/i18n/astro";

// Get translations
const lang = getLanguageFromCookies(Astro.cookies);
const { t } = getTranslations(lang, 'manage');
const tCommon = getTranslations(lang, 'common');

// Serialized client messages for client-side script (avoid using `t` in client scope)
const clientMsgsJson = JSON.stringify({
  configurationIncomplete: t('settings.configurationIncomplete'),
  selectPrimaryEmailForMode: t('settings.selectPrimaryEmailForMode'),
  commonSaving: t('common.saving'),
  configurationSaved: t('settings.configurationSaved'),
  emailSendingPreferencesUpdated: t('settings.emailSendingPreferencesUpdated'),
  failedToSave: t('settings.failedToSave'),
  saveEmailConfiguration: t('settings.saveEmailConfiguration'),
  invalidSignature: t('settings.invalidSignature'),
  changesSaved: t('settings.changesSaved'),
  emailSignatureUpdatedSuccessfully: t('settings.emailSignatureUpdatedSuccessfully'),
  emailSignatureUpdatedSanitized: t('settings.emailSignatureUpdatedSanitized'),
  saveSignature: t('settings.saveSignature'),
  invalidSubject: t('settings.invalidSubject'),
  invalidBody: t('settings.invalidBody'),
  commonSaveChanges: t('common.saveChanges'),
  autoAssignEmployeeSaved: t('settings.autoAssignEmployeeSaved'),
  unexpectedError: tCommon.t('errors.generic')
});

// Components
import AdminShell from "@/components/AdminShell";

// Initialize Supabase client with request context
const supabase = createClient({ 
  request: Astro.request, 
  cookies: Astro.cookies 
});

console.log("[general-settings] Page accessed");

// ============================================================================
// AUTHENTICATION & AUTHORIZATION
// ============================================================================

console.log("[general-settings] Verifying authentication");
const pageContext = await getCompletePageContext(supabase, Astro.cookies);

if (!pageContext) {
  console.error("[general-settings] Authentication failed, redirecting to login");
  return Astro.redirect("/");
}

const { authContext, sidebarData } = pageContext;

console.log("[general-settings] User authenticated:", {
  userId: authContext.user.id,
  employeeId: authContext.employee.id,
  clientId: authContext.employee.client_id,
  isAdmin: authContext.isAdmin
});

const clientId = authContext.employee.client_id;

// Verify admin role using ROLE_IDS constant
if (!authContext.isAdmin) {
  console.warn("[general-settings] Access denied - user is not admin:", {
    userId: authContext.user.id,
    employeeId: authContext.employee.id
  });
  return new Response("Forbidden: Admin access required", { status: 403 });
}

console.log("[general-settings] Admin access verified");

// ============================================================================
// DATA LOADING - ALL SETTINGS
// ============================================================================

console.log("[general-settings] Fetching settings for client_id:", clientId);

// Fetch all required data
let clientSettings, confirmationJSON, truefalseSettingsJSON, clientEmails;
let clientSettingsError, confirmationFetchError, truefalseSettingsFetchError, clientEmailsError;

try {
  [ 
    {data: clientSettings, error: clientSettingsError},
    {data: confirmationJSON, error: confirmationFetchError},
    {data: truefalseSettingsJSON, error: truefalseSettingsFetchError},
    {data: clientEmails, error: clientEmailsError},
  ] = await Promise.all([
    // Client settings (signature, email mode, primary email)
    supabase
      .from('clients')
      .select('email_signature, email_sending_mode, primary_email_id')
      .eq("id", clientId)
      .single(),
    
    //confirmation mail 
    supabase
      .from('clients')
      .select('confirm_mail, confirmation_mail_subject, confirmation_mail_mode')
      .eq('id', clientId)
      .single(),

    //true false settings
    supabase
      .from('clients')
      .select('auto_assign_employee_on_send')
      .eq('id', clientId)
      .single(),

    // All available client emails for dropdown - KORRIGIERT
    supabase
      .from('client-emails')
      .select(`
        id,
        email_address,
        active,
        provider_id,
        "email-provider" (
          name,
          smtp,
          smtp_port
        )
      `)
      .eq('client_id', clientId)  // WICHTIG: Nur Emails dieses Clients
      .eq('active', true)
      .order('email_address')
  ]);
} catch (error) {
  console.error('[general-settings] Critical error loading initial data:', error);
  return new Response("Internal Server Error: Failed to load settings", { status: 500 });
}

//error handling

if (confirmationFetchError) {
  console.log('[Settings-script] Error fetching the confirmation mail', confirmationFetchError);
}

if(truefalseSettingsFetchError) {
  console.log('[Settings-script] Error fetching the true/false settings', truefalseSettingsFetchError);
}
  
if (clientSettingsError) {
  console.error('[Settings] Error fetching client settings:', clientSettingsError);
}

if (clientEmailsError) {
  console.error('[Settings] Error fetching client emails:', clientEmailsError);
}

// Data processing
const signature = clientSettings?.email_signature || '';
const emailSendingMode = clientSettings?.email_sending_mode || 'primary';
const primaryEmailId = clientSettings?.primary_email_id;
const availableEmails = clientEmails || [];

// DEBUG Logging
console.log('[Settings] Available emails for client', clientId, ':', availableEmails);
console.log('[Settings] Client settings:', { emailSendingMode, primaryEmailId });

const confirmation_subject = confirmationJSON?.confirmation_mail_subject;
const confirmation_body = confirmationJSON?.confirm_mail;
const confirmation_mail_mode = confirmationJSON?.confirmation_mail_mode || 'all';

const auto_assign_employee_on_send = truefalseSettingsJSON?.auto_assign_employee_on_send;


console.log("[general-settings] Page setup complete, rendering");
---

<Layout title={t('pages.settings.pageTitle')}>
  <AdminShell 
    client:load
    user={sidebarData.user}
    firstTeam={sidebarData.team ?? undefined}
    crumbParentLabel={tCommon.t('sidebar.administration')}
    crumbParentHref="/manage/settings"
    crumbCurrent={t('pages.settings.pageTitle')}
    isAdmin={authContext.isAdmin}
    isPlatformAdmin={pageContext.isPlatformAdmin}
    currentPath="/manage/settings"
    employeeId={sidebarData.employeeId}
    clientId={sidebarData.clientId}
    subscriptionTier={sidebarData.subscriptionTier}
  >
    <div class="space-y-8">
      <!-- Page Header -->
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="space-y-1 mt-2">
          <h1 class="text-2xl font-semibold tracking-tight">{t('pages.settings.heading')}</h1>
          <p class="text-sm text-muted-foreground">
            {t('pages.settings.description')}
          </p>
        </div>
      </div>

      <!-- Settings Sections -->
      <div class="space-y-6">
        
        <!-- Email Sending Configuration Section -->
        <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
          <div class="p-6 space-y-4">
            <!-- Section Header -->
            <div class="space-y-1">
              <h3 class="text-lg font-semibold leading-none tracking-tight">
                {t('pages.settings.emailConfig.title')}
              </h3>
              <p class="text-sm text-muted-foreground">
                {t('pages.settings.emailConfig.description')}
              </p>
            </div>

            <!-- Error Alert (if emails fetch failed) -->
            {clientEmailsError && (
              <div class="rounded-lg border border-destructive/50 bg-destructive/10 p-4">
                <div class="flex items-start gap-3">
                  <svg class="h-5 w-5 text-destructive mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                  </svg>
                  <div class="space-y-1">
                    <p class="text-sm font-medium text-destructive">
                      {t('pages.settings.emailConfig.errorTitle')}
                    </p>
                    <p class="text-sm text-muted-foreground">
                      {t('pages.settings.emailConfig.errorDescription')}
                    </p>
                  </div>
                </div>
              </div>
            )}

            <!-- No Emails Warning -->
            {availableEmails.length === 0 && !clientEmailsError && (
              <div class="rounded-lg border border-amber-200 bg-amber-50 p-4">
                <div class="flex items-start gap-3">
                  <svg class="h-5 w-5 text-amber-600 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                  </svg>
                  <div class="space-y-1">
                    <p class="text-sm font-medium text-amber-800">
                      {t('pages.settings.emailConfig.noEmails')}
                    </p>
                    <p class="text-sm text-amber-700">
                      {t('pages.settings.emailConfig.addFirst')}
                    </p>
                  </div>
                </div>
              </div>
            )}

            <!-- Sending Mode Selection -->
            {availableEmails.length > 0 && (
              <div class="space-y-4">
                <!-- Mode Selection -->
                <div class="space-y-2">
                  <label class="text-sm font-medium leading-none">{t('pages.settings.emailConfig.sendingMode')}</label>
                  <div class="grid gap-2">
                    <label class="flex items-center space-x-2">
                      <input 
                        type="radio" 
                        name="sendingMode" 
                        value="primary" 
                        class="h-4 w-4 text-primary border-gray-300 focus:ring-primary"
                        checked={emailSendingMode === 'primary'}
                      />
                      <span class="text-sm">
                        <span class="font-medium">{t('pages.settings.emailConfig.alwaysFrom')}</span>
                        <span class="text-muted-foreground block text-xs">{t('pages.settings.emailConfig.alwaysFromDescription')}</span>
                      </span>
                    </label>
                    
                    <label class="flex items-center space-x-2">
                      <input 
                        type="radio" 
                        name="sendingMode" 
                        value="thread-based" 
                        class="h-4 w-4 text-primary border-gray-300 focus:ring-primary"
                        checked={emailSendingMode === 'thread-based'}
                      />
                      <span class="text-sm">
                        <span class="font-medium">{t('pages.settings.emailConfig.matchInbox')}</span>
                        <span class="text-muted-foreground block text-xs">{t('pages.settings.emailConfig.matchInboxDescription')}</span>
                      </span>
                    </label>
                  </div>
                </div>

                <!-- Primary Email Selection (only show when mode is primary) -->
                <div id="primaryEmailSection" class={`space-y-2 ${emailSendingMode !== 'primary' ? 'hidden' : ''}`}>
                  <label for="primaryEmail" class="text-sm font-medium leading-none">{t('pages.settings.emailConfig.primaryAccount')}</label>
                  <select 
                    id="primaryEmail"
                    class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                  >
                    <option value="">Select primary email...</option>
                    {availableEmails.map((email) => (
                      <option 
                        value={email.id} 
                        selected={email.id === primaryEmailId}
                      >
                      {email.email_address} ({(email['email-provider'] as any)?.name || 'Unknown Provider'})
                      </option>
                    ))}
                  </select>
                  <p class="text-xs text-muted-foreground">
                    {t('pages.settings.emailConfig.selectAccount')}
                  </p>
                </div>

                <!-- Action Button -->
                <div class="flex items-center justify-end pt-2">
                  <button
                    id="save-email-config"
                    type="button"
                    class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2"
                  >
                    <svg class="mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    {t('common.saveChanges')}
                  </button>
                </div>
              </div>
            )}
          </div>
        </div>

        <!-- Email Signature Section -->
        <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
          <div class="p-6 space-y-4">
            <!-- Section Header -->
            <div class="space-y-1">
              <h3 class="text-lg font-semibold leading-none tracking-tight">
                {t('pages.settings.emailSignature.title')}
              </h3>
              <p class="text-sm text-muted-foreground">
                {t('pages.settings.emailSignature.description')}
              </p>
            </div>

            <!-- Error Alert (if signature fetch failed) -->
            {clientSettingsError && (
              <div class="rounded-lg border border-destructive/50 bg-destructive/10 p-4">
                <div class="flex items-start gap-3">
                  <svg
                    class="h-5 w-5 text-destructive mt-0.5"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"
                    />
                  </svg>
                  <div class="space-y-1">
                    <p class="text-sm font-medium text-destructive">
                      {t('pages.settings.emailSignature.errorTitle')}
                    </p>
                    <p class="text-sm text-muted-foreground">
                      {t('pages.settings.emailSignature.errorDescription')}
                    </p>
                  </div>
                </div>
              </div>
            )}

            <!-- Signature Editor (TipTap Rich Text) -->
            <SettingsSignatureEditor
              client:load
              initialContent={signature}
              translations={{
                label: t('pages.settings.emailSignature.signature'),
                placeholder: t('pages.settings.emailSignature.placeholder'),
                hint: t('pages.settings.emailSignature.hint'),
                save: t('common.save'),
                saving: t('common.saving'),
                invalidSignature: t('settings.invalidSignature'),
                changesSaved: t('settings.changesSaved'),
                updatedSuccessfully: t('settings.emailSignatureUpdatedSuccessfully'),
                updatedSanitized: t('settings.emailSignatureUpdatedSanitized'),
                failedToSave: t('settings.failedToSave'),
                unexpectedError: tCommon.t('errors.generic'),
              }}
            />
          </div>
        </div>

        <!-- Confirmation Email Section -->
        <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
          <div class="p-6 space-y-4">
            <!-- Section Header -->
            <div class="space-y-1">
              <h3 class="text-lg font-semibold leading-none tracking-tight">
                {t('settings.confirmMail')}
              </h3>
              <p class="text-sm text-muted-foreground">
                {t('settings.confirmMailDescription')}
              </p>
            </div>

            <!-- Error Alert (if fetch failed) -->
            {confirmationFetchError && (
              <div class="rounded-lg border border-destructive/50 bg-destructive/10 p-4">
                <div class="flex items-start gap-3">
                  <svg
                    class="h-5 w-5 text-destructive mt-0.5"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"
                    />
                  </svg>
                  <div class="space-y-1">
                    <p class="text-sm font-medium text-destructive">
                      {t('settings.failedToLoadConfirmationMail')}
                    </p>
                    <p class="text-sm text-muted-foreground">
                      {t('settings.failedToLoadConfirmationMailDescription')}
                    </p>
                  </div>
                </div>
              </div>
            )}

            <!-- Confirmation Mail Editor (TipTap Rich Text) -->
            <SettingsConfirmMailEditor
              client:load
              initialSubject={confirmation_subject || ''}
              initialBody={confirmation_body || ''}
              translations={{
                subjectLabel: t('settings.subject'),
                subjectPlaceholder: t('settings.subjectPlaceholder'),
                subjectHint: t('settings.subjectHint'),
                bodyLabel: t('settings.emailBody'),
                bodyPlaceholder: t('settings.emailBodyPlaceholder'),
                bodyHint: t('settings.emailBodyHint'),
                save: t('settings.saveConfirmationEmail'),
                saving: t('common.saving'),
                invalidSubject: t('settings.invalidSubject'),
                invalidBody: t('settings.invalidBody'),
                changesSaved: t('settings.changesSaved'),
                updatedSuccessfully: t('settings.emailSignatureUpdatedSuccessfully'),
                failedToSave: t('settings.failedToSave'),
                unexpectedError: tCommon.t('errors.generic'),
              }}
            />

            <!-- Confirmation Mail Mode Selector -->
            <div class="mt-6 pt-6 border-t">
              <ConfirmMailModeSelector
                client:load
                initialMode={confirmation_mail_mode}
                translations={{
                  title: t('settings.confirmMailMode'),
                  description: t('settings.confirmMailModeDescription'),
                  modeAll: t('settings.confirmMailModeAll'),
                  modeAllDescription: t('settings.confirmMailModeAllDescription'),
                  modeNewOnly: t('settings.confirmMailModeNewOnly'),
                  modeNewOnlyDescription: t('settings.confirmMailModeNewOnlyDescription'),
                  modeDisabled: t('settings.confirmMailModeDisabled'),
                  modeDisabledDescription: t('settings.confirmMailModeDisabledDescription'),
                  changesSaved: t('settings.changesSaved'),
                  modeSaved: t('settings.confirmMailModeSaved'),
                  failedToSave: t('settings.failedToSave'),
                  unexpectedError: tCommon.t('errors.generic'),
                }}
              />
            </div>
          </div>
        </div>

        <!-- Yes/No settings section -->
        <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
          <!-- Section Header -->
          <div class="space-y-1 pt-6 pl-6">
            <h3 class="text-lg font-semibold leading-none tracking-tight">
              {t('settings.additionalSettings')}
            </h3>
            <p class="text-sm text-muted-foreground">
              {t('settings.additionalSettingsDescription')}
            </p>
          </div>
          <ul class="m-5">
            <!-- Auto assign employee on send setting -->
            <li class="m-2">
              <ToggleSwitch
                client:visible
                defaultChecked={auto_assign_employee_on_send}
                eventName="auto-assign-employee-on-send-toggle"
                label = {t('settings.autoAssignEmployeeOnSend')}
              />
            </li>
          </ul>
      </div>
        <!-- Future Settings Sections -->
        <div class="rounded-lg border border-dashed p-6 text-center">
          <p class="text-sm text-muted-foreground">
            {t('settings.additionalSettingsPlaceholder')}
          </p>
        </div>
      </div>
    </div>
  </AdminShell>

  <script id="i18n-messages" type="application/json">
    {clientMsgsJson}
  </script>

  <script>
    /**
     * Client-side script for settings management
     * Handles email configuration and signature saving
     */

    import { toast } from "sonner";
    import { apiClient } from "../../utils/api";

    // ============================================================================
    // EMAIL CONFIGURATION HANDLING
    // ============================================================================

    /**
     * Email configuration save handler
     */
    const saveEmailConfigButton = document.getElementById("save-email-config");
    const sendingModeRadios = document.querySelectorAll('input[name="sendingMode"]');
    const primaryEmailSelect = document.getElementById("primaryEmail");
    const primaryEmailSection = document.getElementById("primaryEmailSection");

    // Localized messages loaded from JSON script tag
    const msgsEl = document.getElementById('i18n-messages');
    const msgs = msgsEl ? JSON.parse((msgsEl.textContent || '').trim()) : {};

    // Show/hide primary email selection based on mode
    sendingModeRadios.forEach(radio => {
      radio.addEventListener('change', () => {
        if ((radio as HTMLInputElement).value === 'primary') {
          primaryEmailSection?.classList.remove('hidden');
        } else {
          primaryEmailSection?.classList.add('hidden');
        }
      });
    });

    if (saveEmailConfigButton) {
      saveEmailConfigButton.addEventListener("click", async () => {
        const selectedMode = (document.querySelector('input[name="sendingMode"]:checked') as HTMLInputElement)?.value;
        const primaryEmailId = (primaryEmailSelect as HTMLSelectElement)?.value;

        console.log("[settings-script] Saving email configuration:", {
          mode: selectedMode,
          primaryEmailId: primaryEmailId
        });

        // Validation
        if (selectedMode === 'primary' && !primaryEmailId) {
          toast.error(msgs.configurationIncomplete, {
            description: msgs.selectPrimaryEmailForMode
          });
          return;
        }

        // Disable button during save
        saveEmailConfigButton.setAttribute("disabled", "true");
        saveEmailConfigButton.innerHTML = `
          <svg class='mr-2 h-4 w-4 animate-spin' xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24'>
            <circle class='opacity-25' cx='12' cy='12' r='10' stroke='currentColor' stroke-width='4'></circle>
            <path class='opacity-75' fill='currentColor' d='M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z'></path>
          </svg>
          ${msgs.commonSaving}
        `;

        try {
          const response = await apiClient.post('/settings/updateEmailConfig', {
            sendingMode: selectedMode,
            primaryEmailId: selectedMode === 'primary' ? parseInt(primaryEmailId) : null
          });

          if (!response.success) {
            throw new Error(response.error || 'Failed to save email configuration');
          }

          console.log("[settings-script] Email configuration saved successfully");
          
          toast.success(msgs.configurationSaved, {
            description: msgs.emailSendingPreferencesUpdated,
          });

        } catch (error) {
          console.error("[settings-script] Failed to save email configuration:", error);
          
          toast.error(msgs.failedToSave, {
            description: error instanceof Error ? error.message : "An unexpected error occurred.",
          });
        } finally {
          // Re-enable button
          saveEmailConfigButton.removeAttribute("disabled");
          saveEmailConfigButton.innerHTML = `
            <svg class='mr-2 h-4 w-4' xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke-width='1.5' stroke='currentColor'>
              <path stroke-linecap='round' stroke-linejoin='round' d='M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z' />
            </svg>
            ${msgs.saveEmailConfiguration}
          `;
        }
      });
    }

    // ============================================================================
    // AUTO ASSIGN EMPLOYEE TOGGLE HANDLER
    // ============================================================================

    //handler for the auto assign employees on send email toggle
    window.addEventListener('auto-assign-employee-on-send-toggle', async (event) => {
      const value = (event as CustomEvent).detail.value;
      if (typeof value == "boolean") {
        try {
          const response = await apiClient.post('/settings/updateAutoAssignEmployeeOnSend', {
            value: value
          });
          
          if (!response.success) {
            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
          }

          console.log('[settings-script] Auto assign employee setting saved successfully');

          toast.success(msgs.changesSaved, {
            description: msgs.autoAssignEmployeeSaved
          });

        } catch (error) {
          console.error("[settings-script] Failed to save the setting (auto assign employee when email is send):", error);
          toast.error(msgs.failedToSave, {
            description: error instanceof Error ? error.message : "An unexpected error occurred.",
          });
        }
      } else {
        console.error('[settings-script] Value not found');
      }
    });
  </script>
</Layout>
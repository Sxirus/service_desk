---
// src/pages/manage/settings.astro

/**
 * General Settings Page
 * Allows admin users to manage service desk settings and preferences
 * 
 * Security: Admin-only access (role_id = 1)
 * Uses: Auth helper for DRY authentication/authorization
 * 
 * Features:
 * - Email signature management with XSS protection
 * - Email sending configuration (primary email & mode)
 * - Additional settings can be added here
 */

import Layout from "../../layouts/BaseLayout.astro";
import { createClient } from "../../lib/supabase.ts";
import { getCompletePageContext } from "../../lib/auth-helpers.ts";
import ToggleSwitch from "@/components/ToggleSwitch";

// Components
import AdminShell from "@/components/AdminShell";

// Initialize Supabase client with request context
const supabase = createClient({ 
  request: Astro.request, 
  cookies: Astro.cookies 
});

console.log("[general-settings] Page accessed");

// ============================================================================
// AUTHENTICATION & AUTHORIZATION
// ============================================================================

console.log("[general-settings] Verifying authentication");
const pageContext = await getCompletePageContext(supabase, Astro.cookies);

if (!pageContext) {
  console.error("[general-settings] Authentication failed, redirecting to login");
  return Astro.redirect("/");
}

const { authContext, sidebarData } = pageContext;

console.log("[general-settings] User authenticated:", {
  userId: authContext.user.id,
  employeeId: authContext.employee.id,
  clientId: authContext.employee.client_id,
  isAdmin: authContext.isAdmin
});

const clientId = authContext.employee.client_id;

// Verify admin role using ROLE_IDS constant
if (!authContext.isAdmin) {
  console.warn("[general-settings] Access denied - user is not admin:", {
    userId: authContext.user.id,
    employeeId: authContext.employee.id
  });
  return new Response("Forbidden: Admin access required", { status: 403 });
}

console.log("[general-settings] Admin access verified");

// ============================================================================
// DATA LOADING - ALL SETTINGS
// ============================================================================

console.log("[general-settings] Fetching settings for client_id:", clientId);

// Fetch all required data
const [ 
  {data: clientSettings, error: clientSettingsError},
  {data: confirmationJSON, error: confirmationFetchError},
  {data: truefalseSettingsJSON, error: truefalseSettingsFetchError},
  {data: clientEmails, error: clientEmailsError},
] = await Promise.all([
  // Client settings (signature, email mode, primary email)
  supabase
    .from('clients')
    .select('email_signature, email_sending_mode, primary_email_id')
    .eq("id", clientId)
    .single(),
  
  //confirmation mail 
  supabase
    .from('clients')
    .select('confirm_mail, confirmation_mail_subject')
    .eq('id', clientId)
    .single(),

  //true false settings
  supabase
    .from('clients')
    .select('show_assigned_mails_in_all_mails, auto_assign_employee_on_send')
    .eq('id', clientId)
    .single(),

  // All available client emails for dropdown - KORRIGIERT
  supabase
    .from('client-emails')
    .select(`
      id,
      email_address,
      active,
      provider_id,
      "email-provider" (
        name,
        smtp,
        smtp_port
      )
    `)
    .eq('client_id', clientId)  // WICHTIG: Nur Emails dieses Clients
    .eq('active', true)
    .order('email_address')
])

//error handling

if (confirmationFetchError) {
  console.log('[Settings-script] Error fetching the confirmation mail', confirmationFetchError);
}

if(truefalseSettingsFetchError) {
  console.log('[Settings-script] Error fetching the true/false settings', truefalseSettingsFetchError);
}
  
if (clientSettingsError) {
  console.error('[Settings] Error fetching client settings:', clientSettingsError);
}

if (clientEmailsError) {
  console.error('[Settings] Error fetching client emails:', clientEmailsError);
}

// Data processing
const signature = clientSettings?.email_signature || '';
const emailSendingMode = clientSettings?.email_sending_mode || 'primary';
const primaryEmailId = clientSettings?.primary_email_id;
const availableEmails = clientEmails || [];

// DEBUG Logging
console.log('[Settings] Available emails for client', clientId, ':', availableEmails);
console.log('[Settings] Client settings:', { emailSendingMode, primaryEmailId });

const confirmation_subject = confirmationJSON?.confirmation_mail_subject;
const confirmation_body = confirmationJSON?.confirm_mail;

const show_assigned_mails_in_all_mails = truefalseSettingsJSON?.show_assigned_mails_in_all_mails;
const auto_assign_employee_on_send = truefalseSettingsJSON?.auto_assign_employee_on_send;


console.log("[general-settings] Page setup complete, rendering");
---

<Layout title="General Settings">
  <AdminShell 
    client:load
    user={sidebarData.user}
    firstTeam={sidebarData.team ?? undefined}
    crumbParentLabel="Administration"
    crumbParentHref="/manage/settings"
    crumbCurrent="General Settings"
    isAdmin={authContext.isAdmin}
    currentPath="/manage/settings"
    employeeId={sidebarData.employeeId}
    clientId={sidebarData.clientId}
    subscriptionTier={sidebarData.subscriptionTier}
  >
    <div class="space-y-8">
      <!-- Page Header -->
      <div>
        <h1 class="text-3xl font-bold tracking-tight">General Settings</h1>
        <p class="text-muted-foreground">
          Manage the settings and preferences for the service desk
        </p>
      </div>

      <!-- Settings Sections -->
      <div class="space-y-6">
        
        <!-- Email Sending Configuration Section -->
        <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
          <div class="p-6 space-y-4">
            <!-- Section Header -->
            <div class="space-y-1">
              <h3 class="text-lg font-semibold leading-none tracking-tight">
                Email Sending Configuration
              </h3>
              <p class="text-sm text-muted-foreground">
                Configure how emails are sent from your service desk
              </p>
            </div>

            <!-- Error Alert (if emails fetch failed) -->
            {clientEmailsError && (
              <div class="rounded-lg border border-destructive/50 bg-destructive/10 p-4">
                <div class="flex items-start gap-3">
                  <svg class="h-5 w-5 text-destructive mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                  </svg>
                  <div class="space-y-1">
                    <p class="text-sm font-medium text-destructive">
                      Failed to load email configurations
                    </p>
                    <p class="text-sm text-muted-foreground">
                      There was an error loading your email accounts. You can still configure the settings.
                    </p>
                  </div>
                </div>
              </div>
            )}

            <!-- No Emails Warning -->
            {availableEmails.length === 0 && !clientEmailsError && (
              <div class="rounded-lg border border-amber-200 bg-amber-50 p-4">
                <div class="flex items-start gap-3">
                  <svg class="h-5 w-5 text-amber-600 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                  </svg>
                  <div class="space-y-1">
                    <p class="text-sm font-medium text-amber-800">
                      No email accounts configured
                    </p>
                    <p class="text-sm text-amber-700">
                      Please configure at least one email account before setting up sending preferences.
                    </p>
                  </div>
                </div>
              </div>
            )}

            <!-- Sending Mode Selection -->
            {availableEmails.length > 0 && (
              <div class="space-y-4">
                <!-- Mode Selection -->
                <div class="space-y-2">
                  <label class="text-sm font-medium leading-none">Email Sending Mode</label>
                  <div class="grid gap-2">
                    <label class="flex items-center space-x-2">
                      <input 
                        type="radio" 
                        name="sendingMode" 
                        value="primary" 
                        class="h-4 w-4 text-primary border-gray-300 focus:ring-primary"
                        checked={emailSendingMode === 'primary'}
                      />
                      <span class="text-sm">
                        <span class="font-medium">Use Primary Email</span>
                        <span class="text-muted-foreground block text-xs">Always send from your selected primary email address</span>
                      </span>
                    </label>
                    
                    <label class="flex items-center space-x-2">
                      <input 
                        type="radio" 
                        name="sendingMode" 
                        value="thread-based" 
                        class="h-4 w-4 text-primary border-gray-300 focus:ring-primary"
                        checked={emailSendingMode === 'thread-based'}
                      />
                      <span class="text-sm">
                        <span class="font-medium">Thread-Based Response</span>
                        <span class="text-muted-foreground block text-xs">Always reply from the same email that received the original message</span>
                      </span>
                    </label>
                  </div>
                </div>

                <!-- Primary Email Selection (only show when mode is primary) -->
                <div id="primaryEmailSection" class={`space-y-2 ${emailSendingMode !== 'primary' ? 'hidden' : ''}`}>
                  <label for="primaryEmail" class="text-sm font-medium leading-none">Primary Email Address</label>
                  <select 
                    id="primaryEmail"
                    class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                  >
                    <option value="">Select primary email...</option>
                    {availableEmails.map((email) => (
                      <option 
                        value={email.id} 
                        selected={email.id === primaryEmailId}
                      >
                      {email.email_address} ({(email['email-provider'] as any)?.name || 'Unknown Provider'})
                      </option>
                    ))}
                  </select>
                  <p class="text-xs text-muted-foreground">
                    This email will be used as the sender for all outgoing emails in "Primary Email" mode.
                  </p>
                </div>

                <!-- Action Button -->
                <div class="flex items-center justify-end pt-2">
                  <button
                    id="save-email-config"
                    type="button"
                    class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2"
                  >
                    <svg class="mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Save Email Configuration
                  </button>
                </div>
              </div>
            )}
          </div>
        </div>

        <!-- Email Signature Section -->
        <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
          <div class="p-6 space-y-4">
            <!-- Section Header -->
            <div class="space-y-1">
              <h3 class="text-lg font-semibold leading-none tracking-tight">
                Email Signature
              </h3>
              <p class="text-sm text-muted-foreground">
                Configure the default email signature for support responses
              </p>
            </div>

            <!-- Error Alert (if signature fetch failed) -->
            {clientSettingsError && (
              <div class="rounded-lg border border-destructive/50 bg-destructive/10 p-4">
                <div class="flex items-start gap-3">
                  <svg
                    class="h-5 w-5 text-destructive mt-0.5"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"
                    />
                  </svg>
                  <div class="space-y-1">
                    <p class="text-sm font-medium text-destructive">
                      Failed to load email signature
                    </p>
                    <p class="text-sm text-muted-foreground">
                      There was an error loading the signature. You can still edit and save a new one.
                    </p>
                  </div>
                </div>
              </div>
            )}

            <!-- Signature Editor -->
            <div class="space-y-2">
              <label 
                for="signature" 
                class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
              >
                Signature Content
              </label>
              <textarea
                id="signature"
                class="flex min-h-[120px] w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 resize-none"
                placeholder="Enter your email signature here..."
                rows="6"
              >{signature}</textarea>
              <p class="text-xs text-muted-foreground">
                This signature will be automatically appended to all outgoing support emails.
              </p>
            </div>

            <!-- Action Button -->
            <div class="flex items-center justify-end pt-2">
              <button
                id="save-signature"
                type="button"
                class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2"
              >
                <svg
                  class="mr-2 h-4 w-4"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
                Save Signature
              </button>
            </div>
          </div>
        </div>

        <!-- Confirmation Email Section -->
        <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
          <div class="p-6 space-y-4">
            <!-- Section Header -->
            <div class="space-y-1">
              <h3 class="text-lg font-semibold leading-none tracking-tight">
                Confirm Mail
              </h3>
              <p class="text-sm text-muted-foreground">
                Configure the default confirm mail, send when a email reaches you. (If you leave this empty nothing will be send)
              </p>
            </div>

            <!-- Error Alert (if fetch failed) -->
            {confirmationFetchError && (
              <div class="rounded-lg border border-destructive/50 bg-destructive/10 p-4">
                <div class="flex items-start gap-3">
                  <svg
                    class="h-5 w-5 text-destructive mt-0.5"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"
                    />
                  </svg>
                  <div class="space-y-1">
                    <p class="text-sm font-medium text-destructive">
                      Failed to load confirmation mail
                    </p>
                    <p class="text-sm text-muted-foreground">
                      There was an error loading the confirmation mail. You can still edit and save a new one.
                    </p>
                  </div>
                </div>
              </div>
            )}

            <!-- Subject Editor -->
            <div class="space-y-2">
              <label 
                for="confirm-subject" 
                class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
              >
                Subject
              </label>
              <textarea
                id="confirm-subject"
                class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 resize-none"
                placeholder="Enter your email subject here..."
                rows="6"
              >{confirmation_subject}</textarea>
              <p class="text-xs text-muted-foreground">
                This is the subject of the auto send confirmation mail
              </p>
            </div>

            <!-- Email Body Editor -->
            <div class="space-y-2">
              <label 
                for="confirm-body" 
                class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
              >
                Email Body
              </label>
              <textarea
                id="confirm-body"
                class="flex min-h-[120px] w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 resize-none"
                placeholder="Enter your email body here..."
                rows="6"
              >{confirmation_body}</textarea>
              <p class="text-xs text-muted-foreground">
                This is the body of the auto send confirmation mail
              </p>
            </div>

            <!-- Action Button -->
            <div class="flex items-center justify-end pt-2">
              <button
                id="save-confirm-mail"
                type="button"
                class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2"
              >
                <svg
                  class="mr-2 h-4 w-4"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
                Save Confirmation Email
              </button>
            </div>
          </div>
        </div>

        <!-- Yes/No settings section -->
        <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
          <!-- Section Header -->
          <div class="space-y-1 pt-6 pl-6">
            <h3 class="text-lg font-semibold leading-none tracking-tight">
              Additional Settings
            </h3>
            <p class="text-sm text-muted-foreground">
              Configure General settings that apply to all of your employees
            </p>
          </div>
          <ul class="m-5">
            <!-- Show assigned mails in all mails setting -->
            <li class="m-2">
              <ToggleSwitch
                client:visible
                defaultChecked={show_assigned_mails_in_all_mails}
                eventName="show-assigned-mails-toggle"
                label = "Show assigned mails in all mails"
              />
            </li>
            <!-- Auto assign employee on send setting -->
            <li class="m-2">
              <ToggleSwitch
                client:visible
                defaultChecked={auto_assign_employee_on_send}
                eventName="auto-assign-employee-on-send-toggle"
                label = "Auto assign an employee when he sends an answer"
              />
            </li>
          </ul>
      </div>
        <!-- Future Settings Sections -->
        <div class="rounded-lg border border-dashed p-6 text-center">
          <p class="text-sm text-muted-foreground">
            Additional settings will be added here
          </p>
        </div>
      </div>
    </div>
  </AdminShell>

  <script>
    /**
     * Client-side script for settings management
     * Handles email configuration and signature saving
     */

    import { toast } from "sonner";
    import { validateEmailSignature, validateTextInput } from "../../lib/validation";
    import { apiClient } from "../../utils/api";

    // ============================================================================
    // EMAIL CONFIGURATION HANDLING
    // ============================================================================

    /**
     * Email configuration save handler
     */
    const saveEmailConfigButton = document.getElementById("save-email-config");
    const sendingModeRadios = document.querySelectorAll('input[name="sendingMode"]');
    const primaryEmailSelect = document.getElementById("primaryEmail");
    const primaryEmailSection = document.getElementById("primaryEmailSection");

    // Show/hide primary email selection based on mode
    sendingModeRadios.forEach(radio => {
      radio.addEventListener('change', () => {
        if ((radio as HTMLInputElement).value === 'primary') {
          primaryEmailSection?.classList.remove('hidden');
        } else {
          primaryEmailSection?.classList.add('hidden');
        }
      });
    });

    if (saveEmailConfigButton) {
      saveEmailConfigButton.addEventListener("click", async () => {
        const selectedMode = (document.querySelector('input[name="sendingMode"]:checked') as HTMLInputElement)?.value;
        const primaryEmailId = (primaryEmailSelect as HTMLSelectElement)?.value;

        console.log("[settings-script] Saving email configuration:", {
          mode: selectedMode,
          primaryEmailId: primaryEmailId
        });

        // Validation
        if (selectedMode === 'primary' && !primaryEmailId) {
          toast.error("Configuration incomplete", {
            description: "Please select a primary email address for this mode."
          });
          return;
        }

        // Disable button during save
        saveEmailConfigButton.setAttribute("disabled", "true");
        saveEmailConfigButton.innerHTML = `
          <svg class="mr-2 h-4 w-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Saving...
        `;

        try {
          const response = await apiClient.post('/settings/updateEmailConfig', {
            sendingMode: selectedMode,
            primaryEmailId: selectedMode === 'primary' ? parseInt(primaryEmailId) : null
          });

          if (!response.success) {
            throw new Error(response.error || 'Failed to save email configuration');
          }

          console.log("[settings-script] Email configuration saved successfully");
          
          toast.success("Configuration saved", {
            description: "Email sending preferences have been updated.",
          });

        } catch (error) {
          console.error("[settings-script] Failed to save email configuration:", error);
          
          toast.error("Failed to save", {
            description: error instanceof Error ? error.message : "An unexpected error occurred.",
          });
        } finally {
          // Re-enable button
          saveEmailConfigButton.removeAttribute("disabled");
          saveEmailConfigButton.innerHTML = `
            <svg class="mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Save Email Configuration
          `;
        }
      });
    }

    // ============================================================================
    // SIGNATURE HANDLING (existing code)
    // ============================================================================

    const saveSignatureButton = document.getElementById("save-signature");
    const signatureTextarea = document.getElementById("signature") as HTMLTextAreaElement;

    if (saveSignatureButton && signatureTextarea) {
      console.log("[settings-script] Save sigature button handler initialized");

      saveSignatureButton.addEventListener("click", async () => {
        const signature = signatureTextarea.value || "";

        console.log("[settings-script] Validating signature:", {
          signatureLength: signature.length
        });

        // Validate and sanitize input for XSS protection
        const validation = validateEmailSignature(signature);
        
        if (!validation.isValid) {
          console.error("[settings-script] Validation failed:", validation.error);
          toast.error("Invalid signature", {
            description: validation.error
          });
          return;
        }

        const sanitizedSignature = validation.sanitized!;

        console.log("[settings-script] Saving signature:", {
          originalLength: signature.length,
          sanitizedLength: sanitizedSignature.length
        });

        // Disable button during save
        saveSignatureButton.setAttribute("disabled", "true");
        saveSignatureButton.innerHTML = `
          <svg class="mr-2 h-4 w-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Saving...
        `;

        try {
          const response = await apiClient.post('/settings/updateSignature', {
            signature: sanitizedSignature
          });

          if (!response.success) {
            throw new Error(response.error || 'Failed to save signature');
          }

          console.log("[settings-script] Signature saved successfully");
          
          // Update textarea with sanitized value if it was changed
          if (sanitizedSignature !== signature) {
            signatureTextarea.value = sanitizedSignature;
            toast.success("Changes saved", {
              description: "Email signature has been updated (some unsafe content was removed).",
            });
          } else {
            toast.success("Changes saved", {
              description: "Email signature has been updated successfully.",
            });
          }

        } catch (error) {
          console.error("[settings-script] Failed to save signature:", error);
          
          toast.error("Failed to save", {
            description: error instanceof Error ? error.message : "An unexpected error occurred.",
          });
        } finally {
          // Re-enable button
          saveSignatureButton.removeAttribute("disabled");
          saveSignatureButton.innerHTML = `
            <svg class="mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Save Signature
          `;
        }
      });
    } else {
      console.error("[settings-script] Save signature button or textarea not found");
    }

    //save button for the confirmation email
    const saveConfirmationMailButton = document.getElementById('save-confirm-mail');
    const confirmSubjectTextarea = document.getElementById('confirm-subject') as HTMLTextAreaElement;
    const confirmBodyTextarea = document.getElementById('confirm-body') as HTMLTextAreaElement;

    if (saveConfirmationMailButton && confirmSubjectTextarea && confirmBodyTextarea) {
      console.log("[settings-script] Save confirm mail button handler initialized");

      saveConfirmationMailButton.addEventListener("click", async () => {
        let subject = confirmSubjectTextarea.value || "";
        let body = confirmBodyTextarea.value || "";

        console.log("[settings-script] validating confirm mail", {
          subjectlength: subject.length,
          bodylength: body.length
        })

        const validationSubject = validateTextInput(subject);
        const validationBody = validateTextInput(body);

        if (!validationSubject.isValid) {
          console.error("[settings-script] Validation failed:", validationSubject.error);
          toast.error("Invalid subject", {
            description: validationSubject.error
          });
          return;
        } else if (!validationBody.isValid) {
          console.error ("[settings-script] Validation failed", validationBody.error);
          toast.error("Invalid body", {
            description: validationBody.error
          });
          return;
        }

        subject = validationSubject.sanitized || "";
        body = validationBody.sanitized || "";

        console.log("[settings-script] Saving confirmation email");

        //disable button during save
        saveConfirmationMailButton.setAttribute("disabled", "true");
        saveConfirmationMailButton.innerHTML = `
          <svg class="mr-2 h-4 w-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Saving...
        `;

        try {
          const response = await apiClient.post('/settings/updateConfirmMail', {
            subject: subject,
            body: body
          })
          if (!response.success) {
            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
          }

          console.log("[settings-script] Confirm mail saved successfully");

          //updating value incase somethign was changed sanitzing
          confirmSubjectTextarea.value = subject;
          confirmBodyTextarea.value = body;

          toast.success("Changes saved", {
            description: "Email signature has been updated successfully.",
          });

        } catch (error) {
          console.error("[settings-script] Failed to save confirm mail:", error);
          toast.error("Failed to save", {
            description: error instanceof Error ? error.message : "An unexpected error occurred.",
          });
        } finally {
          // Re-enable button
          saveConfirmationMailButton.removeAttribute("disabled");
          saveConfirmationMailButton.innerHTML = `
            <svg class="mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Save Changes
          `;
        }
      })
    } else {
      console.error("[settings-script] Save confirm mail button or textarea not found");
    }

    //handler for the show assigned mails in all mails toggle
    window.addEventListener('show-assigned-mails-toggle', async (event) => {
      const value = (event as CustomEvent).detail.value;
      if (typeof value == "boolean") {
        try {
          const response = await apiClient.post('/settings/updateShowAssignedMails', {
            value: value
          });
          if (!response.success) {
            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
          }

          console.log('[settings-script] Show assigned mails setting saved succesfully');

          toast.success("Changes saved", {
            description: "Assigned mails in all mails setting saved successfully"
          });

        } catch (error) {
          console.error("[settings-script] Failed to save the setting (show assigned mails in all mails)", error);
          toast.error("Failed to save", {
            description: error instanceof Error ? error.message : "An unexpected error occurred.",
          });
        } 
      }else {
        console.error('[settings-script] Value not found');
      }
    });

    //handler for the auto assign employees on send email toggle
    window.addEventListener('auto-assign-employee-on-send-toggle', async (event) => {
      const value = (event as CustomEvent).detail.value;
      if (typeof value == "boolean") {
        try {
          const response = await apiClient.post('/settings/updateAutoAssignEmployeeOnSend', {
            value: value
          });
          
          if (!response.success) {
            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
          }

          console.log('[settings-script] Auto assign employee setting saved successfully');

          toast.success('Changes saved', {
            description: 'Auto assign employee when a mail is send, saved successfully'
          });

        } catch (error) {
          console.error("[settings-script] Failed to save the setting (auto assign employee when email is send):", error);
          toast.error("Failed to save", {
            description: error instanceof Error ? error.message : "An unexpected error occurred.",
          });
        }
      } else {
        console.error('[settings-script] Value not found');
      }
    });
  </script>
</Layout>
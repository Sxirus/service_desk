---
import { getCompletePageContext } from "@/lib/auth-helpers";
import { createClient } from "../../lib/supabase.ts";
import Layout from "../../layouts/BaseLayout.astro";
import AdminShell from "@/components/AdminShell";
import { makeIssue } from "astro:schema";

// Initialize Supabase client with request context
const supabase = createClient({
  request: Astro.request, 
  cookies: Astro.cookies 
});

const pageContext = await getCompletePageContext(supabase, Astro.cookies);

if (!pageContext) {
  console.error("[general-settings] Authentication failed, redirecting to login");
  return Astro.redirect("/");
}

const { authContext, sidebarData } = pageContext;
const clientId = authContext.employee.client_id;

//data fetching
const [
  { data: macros, error: macroError },
  { data: groups, error: groupError}
] = await Promise.all([
  supabase
    .from('macros')
    .select('*')
    .eq('client_id', clientId),

  supabase
    .from('macro_groups')
    .select('*')
    .eq('client_id', clientId)
])

//error handling
if (macroError) {
  console.log('Error loading macros', macroError);
}

if (groupError) {
  console.log('Error loading macro groups', groupError);
}

//data processingxwxw
const macroArray = [
  ...(groups || []).map((group : any ) => ({
    ...group,
    title: group.name,
    isMacro: false
  })),
  ...(macros || []).map((macro : any) => ({
    ...macro,
    isMacro: true
  }))
]

const initialMacroArray = macroArray.filter(item => item.group_id == null);


var first = true


---
<Layout title="Makro Editor">
    <AdminShell 
    client:load
    user={sidebarData.user}
    firstTeam={sidebarData.team ?? undefined}
    crumbParentLabel="Administration"
    crumbParentHref="/manage/settings"
    crumbCurrent="General Settings"
    isAdmin={authContext.isAdmin}
    currentPath="/manage/settings"
  >
    <!-- Page Header -->
    <div class="space-y-6">
      <div>
        <h1 class="text-3xl font-bold tracking-tight">Macro Editor</h1>
        <p class="text-muted-foreground">
          Edit and add macros
        </p>
      </div>

      <div>
        <button id="addButton"></button>
        <div id="main-section">
          <div id="macro-section" class="rounded-lg border-black border-2 bg-card text-card-foreground shadow-sm" data-macro-array={JSON.stringify(macroArray)}>
            {initialMacroArray.map((macro) => {
              const wasFirst = first;
              first = false
              return (
              <div class="relative group">
                <button class={`macro-item hover:cursor-pointer p-3 flex w-full min-h-10 border-black ${wasFirst ? 'border-t-0' : 'border-t-2'}`} 
                  data-macro-id={macro.id} 
                  data-is-macro={macro.isMacro} 
                  data-macro-title={macro.title}
                  data-macro-text={macro.text}
                  >
                  <p class="justify-start">
                    {macro.isMacro ? "📄 "   : "📁 "}
                    {macro.title}
                  </p>
                  {/* Delete Button - nur beim Hover sichtbar */}
                  <button 
                    class="delete-btn absolute right-2 top-1/2 transform -translate-y-1/2 opacity-0 group-hover:opacity-100 transition-opacity bg-red-500 text-white w-6 h-6 rounded text-xs hover:cursor-pointer"
                    data-macro-id={macro.id}
                    data-is-macro={macro.isMacro}
                  >
                    ×
                  </button>
                </button>
              </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </AdminShell>
  <script>

  import  { apiClient } from '../../utils/api.ts';

  var filteredMacroArray: any[] = [];
  const macroArray = JSON.parse(document.getElementById('macro-section')?.dataset.macroArray || '[]') as any[];
  const navigationStack = [{ id: null, title: "Root" }]; // Stack für Navigation

  // Event Delegation auf main-section
  document.getElementById('main-section')?.addEventListener('click', (event) => {
    const target = event.target;
    if (!target || !(target instanceof Element)) return;

    const macroButton = target.closest('.macro-item') as HTMLButtonElement;
    const deleteButton = target.closest('.delete-btn') as HTMLButtonElement;

    if (deleteButton) {
      event.stopPropagation();
      const macroId = deleteButton.dataset.macroId;
      const isMacro = deleteButton.dataset.isMacro === "true";
      if (isMacro) {
        console.log("[Macro Editor] Deleting macro:", macroId);
        deleteMacro(macroId);
      } else {
        console.log("[Macro Editor] Deleting group", macroId);
        deleteGroup(macroId);
      }
      return;
    }

    if (macroButton) {
      const macroId = macroButton.dataset.macroId;
      const isMacro = macroButton.dataset.isMacro === "true";
      const macroTitle = macroButton.dataset.macroTitle;
      
      if (isMacro) {
        const macroText = macroButton.dataset.macroText;
        console.log("[Macro Editor] Starting Macro editor for:", { id: macroId, title: macroTitle, text: macroText });
      } else {
        // Zur Gruppe navigieren
        navigateToGroup(macroId, macroTitle);
      }
    }
  });

  function navigateToGroup(groupId : any, groupTitle : any) {
    console.log("[Macro Editor] Switching to Group:", groupId);
    
    // Zur Navigation History hinzufügen
    navigationStack.push({ id: groupId, title: groupTitle });
    
    // Gruppe anzeigen
    filteredMacroArray = macroArray.filter((item: any) => item.group_id == groupId);
    renderMacroList(filteredMacroArray);
  }

  function goBack() {
    if (navigationStack.length > 1) {
      navigationStack.pop(); // Aktuelle Gruppe entfernen
      const previousGroup = navigationStack[navigationStack.length - 1];
      
      if (previousGroup.id === null) {
        // Zurück zur Root-Ansicht
        filteredMacroArray = macroArray.filter(item => item.group_id == null);
      } else {
        // Zurück zur übergeordneten Gruppe
        filteredMacroArray = macroArray.filter((item: any) => item.group_id == previousGroup.id);
      }
      
      renderMacroList(filteredMacroArray);
      console.log("[Macro Editor] Zurück zu:", previousGroup.title);
    }
  }

  function renderMacroList(macrosToRender : any) {
    const mainSection = document.getElementById('main-section');
    if (mainSection) {
      mainSection.innerHTML = `
        ${navigationStack.length > 1 ? `
          <button onclick="goBack()" class="mb-4 px-4 py-2 bg-gray-200 rounded hover:bg-gray-300">
            ← Zurück zu ${navigationStack[navigationStack.length - 2].title}
          </button>
        ` : ''}
        <div id="macro-section" class="rounded-lg border-black border-2 bg-card text-card-foreground shadow-sm" data-macro-array="${JSON.stringify(macroArray).replace(/"/g, '&quot;')}">
          ${macrosToRender.map((macro : any, index : any) => {
            const wasFirst = index === 0;
            return `
              <div class="relative group">
                <button class="macro-item hover:cursor-pointer p-3 flex w-full min-h-10 border-black ${wasFirst ? 'border-t-0' : 'border-t-2'} pr-12" 
                  data-macro-id="${macro.id}" 
                  data-is-macro="${macro.isMacro}" 
                  data-macro-title="${macro.title}"
                  data-macro-text="${macro.text}">
                  <p class="justify-start">
                    ${macro.isMacro ? "📄 " : "📁 "}
                    ${macro.title}
                  </p>
                </button>
                <button 
                  class="delete-btn absolute right-2 top-1/2 transform -translate-y-1/2 opacity-0 group-hover:opacity-100 transition-opacity bg-red-500 text-white w-6 h-6 rounded text-xs hover:cursor-pointer"
                  data-macro-id="${macro.id}"
                  data-is-macro="${macro.isMacro}"
                >
                  ×
                </button>
              </div>
            `;
          }).join('')}
        </div>
      `;
    }
  }

  async function deleteGroup(groupId: any ) {
    const index = macroArray.findIndex(item => item.id == groupId && item.isMacro == false);
    if (index !== -1) {
      try {
        const response = await apiClient.delete('/macros/deleteMacroGroup', {
          groupId: groupId
        })

        if (!response.success) {
          throw new Error(response.error || "Failed to delete group");
        }

        macroArray.splice(index, 1);
        console.log("[Macro Editor] Deleted group", groupId);

        //Change UI
        const currentGroup = navigationStack[navigationStack.length - 1];
        filteredMacroArray = macroArray.filter((item : any) => item.group_id == currentGroup.id);
        renderMacroList(filteredMacroArray);
      } catch {

      }

    } else {
      console.log("[Macro Editor] Group ID not found:", groupId);
    }
  }

  async function deleteMacro(macroId: any) {
    const index = macroArray.findIndex(item => item.id == macroId && item.isMacro == true);
    if (index !== -1){
      try {
        const response = await apiClient.delete('/macros/deleteMacro', {
          macroId: macroId,
        });

        if (!response.success) {
          throw new Error(response.error || "Failed to delete macro");
        }
          macroArray.splice(index, 1);
          console.log("[Macro Editor] Deleted macro", macroId);

          //change UI
          const currentGroup = navigationStack[navigationStack.length - 1];
          filteredMacroArray = macroArray.filter((item : any) => item.group_id == currentGroup.id);
          renderMacroList(filteredMacroArray);

      } catch (error) {
        console.error("[Macro Editor] An error occured, while deleting the macro", error)
      }
    } else {
      console.log('')
    }
  }

  function clearStackAnGoToRoot(){
    navigationStack.length = 0;
    navigationStack.push({ id: null, title: "Root" });
    filteredMacroArray = macroArray.filter(item => item.group_id == null);
    renderMacroList(filteredMacroArray);
  }

  // Global
  (window as any).goBack = goBack;
  </script>
</Layout>
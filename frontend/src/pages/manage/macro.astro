import { getCompletePageContext } from "@/lib/auth-helpers";
import { createClient } from "../../lib/supabase.ts";
import Layout from "../../layouts/BaseLayout.astro";
import AdminShell from "@/components/AdminShell";

// Initialize Supabase client with request context
const supabase = createClient({
  request: Astro.request, 
  cookies: Astro.cookies 
});

const pageContext = await getCompletePageContext(supabase, Astro.cookies);

if (!pageContext) {
  console.error("[general-settings] Authentication failed, redirecting to login");
  return Astro.redirect("/");
}

const { authContext, sidebarData } = pageContext;
const clientId = authContext.employee.client_id;

//data fetching
const [
  { data: macros, error: macroError },
  { data: groups, error: groupError}
] = await Promise.all([
  supabase
    .from('macros')
    .select('*')
    .eq('client_id', clientId),

  supabase
    .from('macro_groups')
    .select('*')
    .eq('client_id', clientId)
])

//error handling
if (macroError) {
  console.log('Error loading macros', macroError);
}

if (groupError) {
  console.log('Error loading macro groups', groupError);
}

//data processing
const macroArray = [
  ...(groups || []).map((group : any ) => ({
    ...group,
    title: group.name,
    isMacro: false
  })),
  ...(macros || []).map((macro : any) => ({
    ...macro,
    isMacro: true
  }))
]

const initialMacroArray = macroArray.filter(item => item.group_id == null);

var first = true

---
<Layout title="Macro Editor">
    <AdminShell 
    client:load
    user={sidebarData.user}
    firstTeam={sidebarData.team ?? undefined}
    crumbParentLabel="Administration"
    crumbParentHref="/manage/settings"
    crumbCurrent="General Settings"
    isAdmin={authContext.isAdmin}
    currentPath="/manage/settings"
    employeeId={sidebarData.employeeId}
    clientId={sidebarData.clientId}
    subscriptionTier={sidebarData.subscriptionTier}
  >
    <!-- Page Header -->
    <div class="space-y-6">
      <div>
        <h1 class="text-3xl font-bold tracking-tight">Macro Editor</h1>
        <p class="text-muted-foreground">
          Edit and add macros
        </p>
      </div>

      <div>
        <div class="relative inline-block mb-4">
          <button id="addButton" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">+ Add New</button>

          <!--Dropdown -->
          <div id="addDropdown" class="absolute left-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 z-50 hidden">
            <button id="addMacroBtn" class="w-full text-left px-4 py-3 hover:bg-gray-100 flex items-center gap-2 rounded-t-lg">
              <span>📄</span>
              <span>Add Macro</span>
            </button>
            <button id="addGroupBtn" class="w-full text-left px-4 py-3 hover:bg-gray-100 flex items-center gap-2 rounded-b-lg border-t border-gray-100">
              <span>📁</span>
              <span>Add Group</span>
            </button>
          </div>
        </div>
        <div id="main-section">
          <div id="macro-section" class="rounded-lg border-black border-2 bg-card text-card-foreground shadow-sm" data-macro-array={JSON.stringify(macroArray)}>
            {initialMacroArray.map((macro) => {
              const wasFirst = first;
              first = false
              return (
              <div class="relative group">
                <button class={`macro-item hover:cursor-pointer p-3 flex w-full min-h-10 border-black ${wasFirst ? 'border-t-0' : 'border-t-2'}`} 
                  data-macro-id={macro.id} 
                  data-is-macro={macro.isMacro} 
                  data-macro-title={macro.title}
                  data-macro-text={macro.text}
                  >
                  <p class="justify-start">
                    {macro.isMacro ? "📄 "   : "📁 "}
                    {macro.title}
                  </p>
                  {/* Delete Button - nur beim Hover sichtbar */}
                  <button 
                    class="delete-btn absolute right-2 top-1/2 transform -translate-y-1/2 opacity-0 group-hover:opacity-100 transition-opacity bg-red-500 text-white w-6 h-6 rounded text-xs hover:cursor-pointer"
                    data-macro-id={macro.id}
                    data-is-macro={macro.isMacro}
                  >
                    ×
                  </button>
                </button>
              </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </AdminShell>
  <script>
    import  { apiClient } from '../../utils/api.ts';
    import { toast } from "sonner";

    var filteredMacroArray: any[] = [];
    const macroArray = JSON.parse(document.getElementById('macro-section')?.dataset.macroArray || '[]') as any[];
    const navigationStack = [{ id: null, title: "Root" }]; // Stack für Navigation

    const macroVariables = [
      {name: "Customer ID", text: "{customerID}", shopify: false},
      {name: "Employee Name", text: "{employeeName}", shopify: false},
      {name: "Full Customer Name", text: "{customerFullName}", shopify: false},
      {name: "Customer First Name", text: "{customerFirstName}", shopify: false},
      {name: "Customer Last Name", text: "{customerLastName}", shopify: false},
      {name: "Customer Email Adress", text: "{customerEmail}", shopify: false},
      {name: "Last Order Number (Shopify)", text: "{shopifyLastOrderNumber}", shopify: true},
    ]

    const addButton = document.getElementById('addButton');
    const addDropdown = document.getElementById('addDropdown');
    const addMacroBtn = document.getElementById('addMacroBtn');
    const addGroupBtn = document.getElementById('addGroupBtn');

    if (addButton && addDropdown) {
      //toggle dropdown on button click
      addButton.addEventListener('click', (e) => {
        e.stopPropagation();
        addDropdown.classList.toggle('hidden');
      });

      //close dropdown when outside click
      document.addEventListener('click', (e) => {
        const clickedNode = e.target as Node | null;
        if (!addDropdown.contains(clickedNode) && !addButton.contains(clickedNode)) {
          addDropdown.classList.add('hidden');
        }
      });
    }

    //add Macro
    if (addMacroBtn) {
      addMacroBtn.addEventListener('click', () => {
        addDropdown?.classList.add('hidden');
        addMacro()
      })
    }

    //add group
    if (addGroupBtn) {
      addGroupBtn.addEventListener('click', () => {
        addDropdown?.classList.add('hidden');
        addGroup();
      })
    }

    function addMacro() {
      const mainSection = document.getElementById('main-section');
      if (mainSection) {
        if (navigationStack[navigationStack.length - 1].title !== "Editor") {
          navigationStack.push({ id: null, title: 'Editor'})
        }
        mainSection.innerHTML = `
        <button onclick="goBack()" class="mb-4 px-4 py-2 bg-gray-200 rounded hover:bg-gray-300">
          ← Zurück zu ${navigationStack[navigationStack.length - 2].title}
        </button>
        <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
          <div class="p-6 space-y-4">
            <div class="space-y-1">
              <h3 class="text-lg font-semibold leading-none tracking-tight">
                Add New Macro
              </h3>
            </div>

            <!-- Title Editor -->
            <div class="space-y-2">
              <label 
                for="new-macro-title" 
                class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
              >
                Title
              </label>
              <textarea
                id="new-macro-title"
                class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 resize-none"
                placeholder="Enter your title here..."
                rows="6"
              ></textarea>
              <p class="text-xs text-muted-foreground">
                This is the title of the macro.
              </p>
            </div>

            <!-- Macro Text Editor -->
            <div class="space-y-2">
              <label 
                for="new-macro-text" 

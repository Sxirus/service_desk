                class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2"
              >
                <svg
                  class="mr-2 h-4 w-4"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"j
                  />
                </svg>
                Save Macro
              </button>
            </div>
          </div>
        </div>
        <div class="rounded-lg border bg-card text-card-foreground shadow-sm mt-4">
          <div class="p-6 space-y-4">
            <div class="space-y-1">
              <h3 class="text-lg font-semibold leading-none tracking-tight">
                Variables
              </h3>
            </div>
            ${macroVariables.map((variable) => {
              return `
              <p>${variable.name} : ${variable.text}</p>
              `
            }).join('')}
          </div>
        </div>
        `;
        
        //save button
        const saveNewMacroBtn = document.getElementById('save-new-macro-btn');
        const newMacroTitleTextarea = document.getElementById('new-macro-title') as HTMLTextAreaElement;
        const newMacroTextTextarea = document.getElementById('new-macro-text') as HTMLTextAreaElement;
        if (saveNewMacroBtn && newMacroTitleTextarea && newMacroTextTextarea) {
          saveNewMacroBtn.addEventListener('click', async () => {
            const groupId = navigationStack[navigationStack.length - 1].id;
            const title = newMacroTitleTextarea.value || "";
            const text = newMacroTextTextarea.value || "";

            console.log("[Macro Editor] Saving Macro", {
              title: title,
              text: text,
              group: groupId
            });

            // Disable button during save
            saveNewMacroBtn.setAttribute("disabled", "true");
            saveNewMacroBtn.innerHTML = `
              <svg class="mr-2 h-4 w-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Saving...
            `;

            try {
              const response = await apiClient.post('/macros/createMacro', {
                title: title,
                text: text,
                groupId: groupId
              });

              if (!response.success) {
                throw new Error(response.error || "Failed to save macro");
              }

              console.log('[Macro Editor] Created macro successfully')

              toast.success("Macro created", {
                description: "The Macro has been saved.",
              });

              const data = response.data;

              macroArray.push({id: data.id, client_id: data.client_id, title: data.title, text: data.text, group_id: data.group_id, isMacro: true})
            } catch (error) {
              console.error("[Macro Editor] Failed to save macro:", error);
              
              toast.error("Failed to save", {
                description: error instanceof Error ? error.message : "An unexpected error occurred.",
              });
            } finally {
              clearStackAnGoToRoot();
            }
          })
        } else {
          console.log("[Macro Editor] Something went wrong in the Macro editor (Textarea or buttons not found)");
        }
      }
    }

    function addGroup() {
      const mainSection = document.getElementById('main-section');
      if (mainSection) {
        if (navigationStack[navigationStack.length - 1].title !== "Editor") {
          navigationStack.push({ id: null, title: 'Editor'})
        }
        mainSection.innerHTML = `
        <button onclick="goBack()" class="mb-4 px-4 py-2 bg-gray-200 rounded hover:bg-gray-300">

---
// src/pages/manage/users.astro

/**
 * User Management Page
 * Allows admin users to view, create, and manage employee users
 * 
 * Security: Admin-only access (role_id = 1)
 * Uses: Auth helper for DRY authentication/authorization
 * 
 * Features:
 * - View all employees in the company
 * - See assigned roles for each employee
 * - Create new users
 * - Manage user roles
 */

import Layout from "../../layouts/BaseLayout.astro";
import { createClient } from "../../lib/supabase.ts";
import { getAuthContext, getSidebarData } from "../../lib/auth-helpers.ts";

// Components
import type { User } from "@/components/datatable/columns";
import ClientUsersTable from "@/components/datatable/ClientUsersTable";
import CreateUserDialog from "@/components/UserDialog";
import AdminShell from "@/components/AdminShell";

// Initialize Supabase client with request context
const supabase = createClient({ 
  request: Astro.request, 
  cookies: Astro.cookies 
});

console.log("[user-management] Page accessed");

// ============================================================================
// AUTHENTICATION & AUTHORIZATION
// ============================================================================

// Get authenticated user and employee context
console.log("[user-management] Verifying authentication");
const authContext = await getAuthContext(supabase, Astro.cookies);

if (!authContext) {
  console.error("[user-management] Authentication failed, redirecting to login");
  return Astro.redirect("/");
}

console.log("[user-management] User authenticated:", {
  userId: authContext.user.id,
  employeeId: authContext.employee.id,
  clientId: authContext.employee.client_id,
  isAdmin: authContext.isAdmin
});

// Verify admin role
if (!authContext.isAdmin) {
  console.warn("[user-management] Access denied - user is not admin:", {
    userId: authContext.user.id,
    employeeId: authContext.employee.id
  });
  return new Response("Forbidden: Admin access required", { status: 403 });
}

console.log("[user-management] Admin access verified");

// ============================================================================
// DATA LOADING - ROLES
// ============================================================================

// Load all available roles
console.log("[user-management] Loading roles list");
const { data: roleRows, error: rolesListErr } = await supabase
  .from("roles")
  .select("id, name")
  .order("id");

if (rolesListErr) {
  console.error("[user-management] Failed to load roles:", {
    error: rolesListErr.message,
    code: rolesListErr.code
  });
} else {
  console.log("[user-management] Roles loaded:", {
    count: roleRows?.length ?? 0,
    roles: roleRows?.map(r => r.name).join(", ")
  });
}

// ============================================================================
// DATA LOADING - EMPLOYEES
// ============================================================================

// Load all employees for the client
console.log("[user-management] Loading employees for client_id:", authContext.employee.client_id);
const { data: employees, error: empsErr } = await supabase
  .from("employees")
  .select("id, name")
  .eq("client_id", authContext.employee.client_id)
  .order("name");

if (empsErr) {
  console.error("[user-management] Failed to load employees:", {
    error: empsErr.message,
    code: empsErr.code,
    clientId: authContext.employee.client_id
  });
} else {
  console.log("[user-management] Employees loaded:", {
    count: employees?.length ?? 0,
    clientId: authContext.employee.client_id
  });
}

// ============================================================================
// DATA LOADING - ROLE ASSIGNMENTS
// ============================================================================

// Load role-employee relationships
console.log("[user-management] Loading role-employee assignments");
const { data: roleAssignments, error: assignmentsErr } = await supabase
  .from("roles-employees")
  .select("employee_id, role_id");

if (assignmentsErr) {
  console.error("[user-management] Failed to load role assignments:", {
    error: assignmentsErr.message,
    code: assignmentsErr.code
  });
} else {
  console.log("[user-management] Role assignments loaded:", {
    count: roleAssignments?.length ?? 0
  });
}

// ============================================================================
// DATA LOADING - EMPLOYEE EMAILS (SECURITY DEFINER RPC)
// ============================================================================

/**
 * Load employee emails via SECURITY DEFINER RPC
 * This is necessary because auth.users table is not directly accessible
 * The RPC function runs with elevated privileges to safely retrieve emails
 */
const empIds = (employees ?? []).map((e) => e.id);
let emailMap = new Map<number, string>();

if (empIds.length > 0) {
  console.log("[user-management] Fetching employee emails via RPC for", empIds.length, "employees");
  
  const { data: emailRows, error: emailErr } = await supabase.rpc("get_employee_emails", {
    emp_ids: empIds
  });
  
  if (emailErr) {
    console.error("[user-management] Failed to fetch employee emails:", {
      error: emailErr.message,
      code: emailErr.code,
      employeeCount: empIds.length
    });
  } else {
    // Build email lookup map for efficient access
    emailMap = new Map<number, string>(
      (emailRows ?? []).map((row: any) => [
        row.employee_id as number, 
        row.email as string
      ])
    );
    console.log("[user-management] Employee emails retrieved:", {
      count: emailMap.size
    });
  }
}

// ============================================================================
// DATA TRANSFORMATION
// ============================================================================

/**
 * Helper function to get role names for an employee
 * @param empId - Employee ID
 * @returns Array of role IDs assigned to the employee
 */
function getRolesForEmployee(empId: number): number[] {
  const assignmentMap = new Map<number, number[]>();
  
  roleAssignments?.forEach((assignment) => {
    if (!assignmentMap.has(assignment.employee_id)) {
      assignmentMap.set(assignment.employee_id, []);
    }
    assignmentMap.get(assignment.employee_id)!.push(assignment.role_id);
  });
  
  return assignmentMap.get(empId) ?? [];
}

// Transform employee data for the DataTable component
console.log("[user-management] Transforming employee data for table");
const tableData: User[] = (employees ?? []).map((employee) => {
  // Get role IDs for this employee
  const employeeRoleIds = getRolesForEmployee(employee.id);
  
  // Map role IDs to role names
  const roleNames = employeeRoleIds
    .map((roleId) => roleRows?.find((role) => role.id === roleId)?.name)
    .filter(Boolean) // Remove undefined values
    .join(", ");
  
  return {
    id: String(employee.id),
    name: employee.name,
    email: emailMap.get(employee.id) ?? "",
    role: roleNames || "—", // Use em dash if no roles assigned
  } as User;
});

console.log("[user-management] Table data prepared:", {
  rowCount: tableData.length
});

// ============================================================================
// SIDEBAR DATA
// ============================================================================

// Load sidebar data (user info and team details)
console.log("[user-management] Loading sidebar data");
const sidebarData = await getSidebarData(supabase, authContext);

console.log("[user-management] Page setup complete, rendering");
---

<Layout title="User Management">
  <AdminShell 
    client:load
    user={sidebarData.user}
    firstTeam={sidebarData.team ?? undefined}
    crumbParentLabel="Administration"
    crumbParentHref="/manage"
    crumbCurrent="Users"
    isAdmin={authContext.isAdmin}
    currentPath="/manage/users"
  >
    <!-- Page Header with Action Button -->
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold">User Management</h1>
      
      <!-- Create User Dialog Button -->
      <CreateUserDialog 
        client:only="react" 
        roles={roleRows ?? []} 
      />
    </div>

    <!-- Users DataTable -->
    <div class="container mx-auto pb-6 min-h-[300px]">
      <ClientUsersTable 
        client:only="react" 
        data={tableData} 
        roles={roleRows ?? []} 
      />
    </div>
  </AdminShell>
</Layout>
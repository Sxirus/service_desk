---
// src/pages/manage/client.astro

/**
 * Company Settings Page
 * Allows admin users to manage company information and settings
 * 
 * Security: Admin-only access (role_id = 1)
 * Uses: Auth helper for DRY authentication/authorization
 */

import Layout from "../../layouts/BaseLayout.astro";
import { createClient } from "../../lib/supabase.ts";
import { getCompletePageContext } from "../../lib/auth-helpers.ts";
import { ROLE_IDS } from "../../types/database.ts";
import type { Client } from "../../types/database.ts";

// Components
import CompanyManagementForm from "@/components/CompanyManagementForm";
import AdminShell from "@/components/AdminShell";

// Initialize Supabase client with request context
const supabase = createClient({ 
  request: Astro.request, 
  cookies: Astro.cookies 
});

console.log("[client-settings] Page accessed");

// ============================================================================
// AUTHENTICATION & AUTHORIZATION
// ============================================================================

console.log("[client-settings] Verifying authentication");
const pageContext = await getCompletePageContext(supabase, Astro.cookies);

if (!pageContext) {
  console.error("[client-settings] Authentication failed, redirecting to login");
  return Astro.redirect("/");
}

const { authContext, sidebarData } = pageContext;

console.log("[client-settings] User authenticated:", {
  userId: authContext.user.id,
  employeeId: authContext.employee.id,
  clientId: authContext.employee.client_id,
  isAdmin: authContext.isAdmin
});

// Verify admin role using ROLE_IDS constant
if (!authContext.isAdmin) {
  console.warn("[client-settings] Access denied - user is not admin:", {
    userId: authContext.user.id,
    employeeId: authContext.employee.id
  });
  return new Response("Forbidden: Admin access required", { status: 403 });
}

console.log("[client-settings] Admin access verified");

// ============================================================================
// DATA LOADING
// ============================================================================

// Load company data with all relevant fields
console.log("[client-settings] Loading company data for client_id:", authContext.employee.client_id);

const { data: companyData, error: companyErr } = await supabase
  .from("clients")
  .select(`
    id, 
    name, 
    address_street, 
    address_city, 
    address_zip, 
    address_country, 
    vat,
    website
  `)
  .eq("id", authContext.employee.client_id)
  .single();

if (companyErr) {
  console.error("[client-settings] Failed to load company data:", {
    error: companyErr.message,
    code: companyErr.code,
    clientId: authContext.employee.client_id
  });
} else {
  console.log("[client-settings] Company data loaded successfully:", {
    companyId: companyData?.id,
    companyName: companyData?.name
  });
}

console.log("[client-settings] Page setup complete, rendering");

// ============================================================================
// PREPARE FORM DATA
// ============================================================================

// Prepare initial form data with fallbacks for missing fields
const initialFormData = {
  id: companyData?.id ?? authContext.employee.client_id,
  name: companyData?.name ?? "",
  address: companyData?.address_street ?? "",
  city: companyData?.address_city ?? "",
  postalCode: companyData?.address_zip ?? "",
  country: companyData?.address_country ?? "",
  vat: companyData?.vat ?? "",
  website: companyData?.website ?? ""
};
---

<Layout title="Company Settings">
  <AdminShell 
    client:load
    user={sidebarData.user}
    firstTeam={sidebarData.team ?? undefined}
    crumbParentLabel="Administration"
    crumbParentHref="/manage/settings"
    crumbCurrent="Company"
    isAdmin={authContext.isAdmin}
    currentPath="/manage/client"
  >
    <div class="space-y-6">
      <!-- Page Header -->
      <div>
        <h1 class="text-3xl font-bold tracking-tight">Company Settings</h1>
        <p class="text-muted-foreground">
          Manage your company information and settings.
        </p>
      </div>

      <!-- Company Management Form -->
      <div class="max-w">
        <CompanyManagementForm 
          client:only="react" 
          initialData={initialFormData}
        />
      </div>
    </div>
  </AdminShell>
</Layout>
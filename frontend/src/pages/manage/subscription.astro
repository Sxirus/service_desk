---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { createClient } from "@/lib/supabase";
import { getCompletePageContext } from "@/lib/auth-helpers";
import SubscriptionManager from "@/components/SubscriptionManager";
import AdminShell from "@/components/AdminShell";
import { getTranslations, getLanguageFromCookies } from "@/i18n/astro";

// Get translations
const lang = getLanguageFromCookies(Astro.cookies);
const { t } = getTranslations(lang, 'manage');
const tCommon = getTranslations(lang, 'common');

// Create Supabase client with server-side rendering support
const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

// Get complete page context (auth + sidebar data)
const pageContext = await getCompletePageContext(supabase, Astro.cookies);

if (!pageContext) {
  return Astro.redirect("/");
}

const { authContext, sidebarData } = pageContext;

// Admin gate – subscription management is admin-only
if (!authContext.isAdmin) {
  return new Response('Forbidden', { status: 403 });
}

// Get session for API calls
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/");

// Use isAdmin from authContext
const isAdmin = authContext.isAdmin;
---

<BaseLayout title={t('pages.subscription.pageTitle')}>
  <AdminShell
    client:load
    user={sidebarData.user}
    firstTeam={sidebarData.team ?? undefined}
    isAdmin={isAdmin}
    isPlatformAdmin={pageContext.isPlatformAdmin}
    currentPath="/manage/subscription"
    crumbParentLabel={tCommon.t('sidebar.administration')}
    crumbParentHref="/manage"
    crumbCurrent={t('pages.subscription.pageTitle')}
    employeeId={sidebarData.employeeId}
    clientId={sidebarData.clientId}
    subscriptionTier={sidebarData.subscriptionTier}
  >
    <SubscriptionManager client:load />
  </AdminShell>
</BaseLayout>

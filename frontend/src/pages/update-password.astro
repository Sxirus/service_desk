---
import Layout from "../layouts/BaseLayout.astro";
import { createClient } from "../lib/supabase.ts";
import { getTranslations, getLanguageFromCookies } from "@/i18n/astro";
import "../styles/global.css";

// Get translations for the page
const lang = getLanguageFromCookies(Astro.cookies);
const { t } = getTranslations(lang, 'auth');

// Create Supabase client with server-side rendering support
const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

// 1) Exchange PKCE code from URL if present (?code=...)
const url = new URL(Astro.request.url);
const authCode = url.searchParams.get("code");

// Initialize status variables
let statusMsg = "";
let errorMsg = "";
let canShowForm = false;

// If auth code is present, exchange it for a session
if (authCode) {
  try {
    const { error } = await supabase.auth.exchangeCodeForSession(authCode);
    if (error) errorMsg = error.message;
  } catch (e: any) {
    errorMsg = e?.message ?? t('updatePassword.codeExchangeError');
  }
}

// 2) Check if a session exists after the (possible) code exchange
const { data: { session } } = await supabase.auth.getSession();
if (!session) {
  statusMsg = t('updatePassword.noValidCode');
} else {
  canShowForm = true;
}

// 3) Handle password update on POST request
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const password = String(form.get("password") ?? "");
  const confirm  = String(form.get("confirm") ?? "");

  // Validate session exists
  if (!session) {
    errorMsg = t('updatePassword.sessionMissing');
  } 
  // Validate password length
  else if (password.length < 8) {
    errorMsg = t('updatePassword.passwordTooShort');
  } 
  // Validate passwords match
  else if (password !== confirm) {
    errorMsg = t('updatePassword.passwordsDoNotMatch');
  } 
  // Update password
  else {
    const { error } = await supabase.auth.updateUser({ password });
    if (error) {
      errorMsg = error.message;
    } else {
      // Password updated successfully - redirect to dashboard
      return Astro.redirect("/dashboard");
    }
  }
  canShowForm = true;
}

// Get public keys for client-side Supabase snippet
const PUBLIC_SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const PUBLIC_SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<Layout title={t('updatePassword.pageTitle')}>
  <!-- Password reset form section -->
  <section class="flex flex-col items-center justify-center m-30">
    <h1 class="text-4xl font-bold mb-6">{t('updatePassword.title')}</h1>

    <!-- Display status message if present -->
    {statusMsg && <p id="status" class="mb-6 text-center text-sm text-gray-600">{statusMsg}</p>}
    
    <!-- Display error message if present -->
    {errorMsg && <p id="error" class="mb-4 text-red-600 text-sm" role="alert">{errorMsg}</p>}

    {canShowForm ? (
      <!-- Password update form -->
      <form method="post" class="flex flex-col gap-3 w-full max-w-md" autocomplete="off">
        <label for="password">{t('updatePassword.newPassword')}</label>
        <input
          type="password"
          name="password"
          id="password"
          class="border border-gray-500 rounded-md p-2"
          minlength="8"
          required
          autocomplete="new-password"
        />

        <label for="confirm">{t('updatePassword.confirmPassword')}</label>
        <input
          type="password"
          name="confirm"
          id="confirm"
          class="border border-gray-500 rounded-md p-2"
          minlength="8"
          required
          autocomplete="new-password"
        />

        <button
          type="submit"
          class="bg-gray-600 hover:bg-gray-700 p-2 rounded-md text-white font-bold w-full cursor-pointer"
        >
          {t('updatePassword.submitButton')}
        </button>
      </form>
    ) : (
      <!-- Loading message - will be removed client-side if hash recovery is detected -->
      <div id="legacy-wait" class="text-sm text-gray-600">Loading recovery session…</div>
    )}
  </section>

  <!-- Supabase configuration for client-side snippet -->
  <script id="sb-config" type="application/json">
    {JSON.stringify({ url: PUBLIC_SUPABASE_URL, anonKey: PUBLIC_SUPABASE_ANON_KEY })}
  </script>
</Layout>

<!--
  Client-side snippet: supports legacy links with #access_token=...&refresh_token=...&type=recovery
  Flow:
    - Parse hash → find tokens → setSession()
    - Remove hash → reload page (so SSR now sees a session)
    - If session already exists, nothing happens
-->
<script type="module">
  // If SSR already has a session, we don't need to do anything
  // (the 'canShowForm' variable only exists server-side; we check client-side simply for hash)
  const hash = window.location.hash || "";
  
  // Check if this is a legacy recovery link with tokens in hash
  if (!hash.includes("access_token") || !hash.includes("refresh_token")) {
    // Nothing to do - no recovery tokens in hash
  } else {
    // Get Supabase configuration from embedded script
    const cfgEl = document.getElementById("sb-config");
    const { url, anonKey } = JSON.parse(cfgEl?.textContent || "{}");
    
    if (!url || !anonKey) {
      console.error("[update-password] Supabase config fehlt");
    } else {
      // Dynamically import Supabase client
      const { createClient } = await import("https://esm.sh/@supabase/supabase-js@2");

      // Create client with session persistence
      const supa = createClient(url, anonKey, {
        auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: false },
      });

      // Parse tokens from URL hash
      const params = new URLSearchParams(hash.replace(/^#/, ""));
      const access_token = params.get("access_token");
      const refresh_token = params.get("refresh_token");
      const type = params.get("type");

      // If this is a recovery link with valid tokens
      if (type === "recovery" && access_token && refresh_token) {
        try {
          // Set the session using the tokens
          const { data, error } = await supa.auth.setSession({ access_token, refresh_token });
          if (error) {
            console.error("[update-password] setSession error:", error.message);
          } else {
            // Remove hash from URL and reload so SSR sees the session
            history.replaceState(null, "", window.location.pathname + window.location.search);
            location.reload();
          }
        } catch (e) {
          console.error("[update-password] setSession threw:", e);
        }
      }
    }
  }
</script>

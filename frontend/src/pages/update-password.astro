---
import Layout from "../layouts/BaseLayout.astro";
import { createClient } from "../lib/supabase.ts";
import "../styles/global.css";

const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

// 1) PKCE-Code aus der URL eintauschen, falls vorhanden
const url = new URL(Astro.request.url);
const authCode = url.searchParams.get("code");
let statusMsg = "";
let errorMsg = "";
let canShowForm = false;

if (authCode) {
  try {
    const { error } = await supabase.auth.exchangeCodeForSession(authCode);
    if (error) {
      errorMsg = error.message;
    }
  } catch (e: any) {
    errorMsg = e?.message ?? "Fehler beim Einlösen des Codes.";
  }
}

// 2) Prüfen, ob nach dem Tausch eine Session existiert
const { data: { session } } = await supabase.auth.getSession();
if (!session) {
  statusMsg = "Kein gültiger Wiederherstellungscode gefunden. Öffne den Link aus der E-Mail erneut.";
} else {
  canShowForm = true;
}

// 3) Passwort setzen bei POST
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const password = String(form.get("password") ?? "");
  const confirm  = String(form.get("confirm") ?? "");

  if (!session) {
    errorMsg = "Sitzung fehlt. Öffne den Link aus der E-Mail erneut.";
  } else if (password.length < 8) {
    errorMsg = "Das Passwort muss mindestens 8 Zeichen lang sein.";
  } else if (password !== confirm) {
    errorMsg = "Die Passwörter stimmen nicht überein.";
  } else {
    const { error } = await supabase.auth.updateUser({ password });
    if (error) {
      errorMsg = error.message;
    } else {
      // Optional: Hinweis anzeigen statt Redirect
      return Astro.redirect("/dashboard");
    }
  }
  canShowForm = true;
}
---

<Layout>
  <section class="flex flex-col items-center justify-center m-30">
    <h1 class="text-4xl font-bold mb-6">Passwort neu setzen</h1>

    {statusMsg && <p class="mb-6 text-center text-sm text-gray-600">{statusMsg}</p>}
    {errorMsg && <p class="mb-4 text-red-600 text-sm" role="alert">{errorMsg}</p>}

    {canShowForm ? (
      <form method="post" class="flex flex-col gap-3 w-full max-w-md" autocomplete="off">
        <label for="password">Neues Passwort</label>
        <input
          type="password"
          name="password"
          id="password"
          class="border border-gray-500 rounded-md p-2"
          minlength="8"
          required
          autocomplete="new-password"
        />

        <label for="confirm">Neues Passwort wiederholen</label>
        <input
          type="password"
          name="confirm"
          id="confirm"
          class="border border-gray-500 rounded-md p-2"
          minlength="8"
          required
          autocomplete="new-password"
        />

        <button
          type="submit"
          class="bg-gray-600 hover:bg-gray-700 p-2 rounded-md text-white font-bold w-full cursor-pointer"
        >
          Passwort setzen
        </button>
      </form>
    ) : null}
  </section>
</Layout>

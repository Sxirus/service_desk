# ── General ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ── Frontend URL (CORS origin + redirect URLs) ───────────────────────────────
FRONTEND_URL=https://kundaro.de

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# ── Encryption ────────────────────────────────────────────────────────────────
# AES-256-GCM key — MUST match the imap-worker's ENCRYPTION_SECRET
# Use a 64-char hex string (recommended): openssl rand -hex 32
ENCRYPTION_SECRET=your_64_char_hex_encryption_key

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ── Shopify ───────────────────────────────────────────────────────────────────
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_SECRET=your_shopify_secret
SHOPIFY_REDIRECT_URI=https://api.kundaro.de/api/shopify/callback

# ── Translation Worker ────────────────────────────────────────────────────────
# Internal Docker URL (translation-worker is not publicly exposed)
TRANSLATION_SERVICE_URL=http://translation-worker:3002
# HMAC shared secret — MUST match translation-worker's TRANSLATION_SERVICE_SECRET
TRANSLATION_SERVICE_SECRET=your_long_random_secret

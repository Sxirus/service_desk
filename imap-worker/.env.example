# ── Required ──────────────────────────────────────────────────────────────────

# Supabase project URL (same as backend)
SUPABASE_URL=https://your-project.supabase.co

# Supabase service-role key (same as backend)
SUPABASE_KEY=your-service-role-key

# AES-256-GCM encryption key — MUST be identical to the backend's ENCRYPTION_SECRET
# Passwords are encrypted by the backend and decrypted here.
# Accepted formats:
#   64-character hex string (recommended): e.g. a3f1...
#   Any plain string (will be SHA-256 hashed to 32 bytes)
ENCRYPTION_SECRET=your-64-char-hex-secret

# ── Optional ──────────────────────────────────────────────────────────────────

# Set to 'production' to enable strict TLS certificate validation for IMAP connections
NODE_ENV=production

# Log verbosity: error | warn | info | debug  (default: info)
LOG_LEVEL=info

# How often (ms) to re-scan Supabase for new/removed email accounts (default: 60000)
SYNC_INTERVAL_MS=60000

NODE_ENV=development
PORT=3002
LOG_LEVEL=info

# z.ai / GLM API
ZAI_API_URL=https://api.z.ai/api/paas/v4/chat/completions
ZAI_API_KEY=your_zai_api_key
ZAI_MODEL=glm-4.7
ZAI_MAX_TOKENS=2048
ZAI_TIMEOUT_MS=60000

# Shared secret used by backend <-> translation-worker HMAC signing
TRANSLATION_SERVICE_SECRET=replace_with_long_random_secret

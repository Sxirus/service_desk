# ── General ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3002
LOG_LEVEL=info

# ── z.ai / GLM Translation API ───────────────────────────────────────────────
ZAI_API_URL=https://api.z.ai/api/paas/v4/chat/completions
ZAI_API_KEY=your_zai_api_key
ZAI_MODEL=glm-4.7
ZAI_MAX_TOKENS=2048
ZAI_TIMEOUT_MS=60000

# ── Service Auth ──────────────────────────────────────────────────────────────
# HMAC shared secret — MUST match backend's TRANSLATION_SERVICE_SECRET
TRANSLATION_SERVICE_SECRET=your_long_random_secret
